	measure 'Flights page title' =
			
			"Flights"
		displayFolder: 40 Flights
		lineageTag: d23d8812-396f-5911-b356-5dcde8cc4337

	measure 'Flights page subtitle' =
			
			"Manage, track and explore all your flights"
		displayFolder: 40 Flights
		lineageTag: 36d20416-52b0-55f4-9dbe-68436603bd9c

	measure 'Selected flight status' =
			
			SELECTEDVALUE ( 'Flight status'[Status], "All" )
		displayFolder: 40 Flights
		lineageTag: 850299c4-5284-5a07-a014-e0c76686088d

	measure 'Passengers this period' =
			
			VAR _d1 = [Period start]
			VAR _d2 = [Period end]
			VAR _t = [Reference time]
			RETURN
			    CALCULATE ( SUM ( FactFlight[Passengers] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] <= _t )
		formatString: #,0
		displayFolder: 40 Flights
		lineageTag: ee0b48fa-ae9f-50cb-9e77-037a90ab7d41

	measure 'Passengers previous period' =
			
			VAR _d1 = [Previous start]
			VAR _d2 = [Previous end]
			VAR _fin = _d2 + IF ( [Selected period] = "Month", 1, [Reference time] - [Reference date] )
			RETURN
			    CALCULATE ( SUM ( FactFlight[Passengers] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] < _fin )
		formatString: #,0
		displayFolder: 40 Flights
		lineageTag: f60281f0-6248-54c6-b393-40d7f3ef73fa

	measure 'Passengers change' =
			
			DIVIDE ( [Passengers this period] - [Passengers previous period], [Passengers previous period] )
		formatString: 0 %
		displayFolder: 10 KPI
		lineageTag: 8c7e1eee-468f-5634-9b94-1bd206885b24

	measure 'Passengers change label' =
			
			VAR _c = [Passengers change]
			RETURN
			    IF ( NOT ISBLANK ( _c ), IF ( _c >= 0, "↑ ", "↓ " ) & FORMAT ( ABS ( _c ), IF ( ABS ( _c ) < 0.0095, "0.0 %", "0 %" ), "en-US" ) )
		displayFolder: 10 KPI
		lineageTag: f09a5cd0-1b62-579f-b118-25ccb08423e0

	measure 'Passengers change color' =
			
			IF ( [Passengers change] >= 0, "#2F9E5B", "#D9534F" )
		displayFolder: 10 KPI
		lineageTag: 844c1ee3-db6d-5924-86c9-9c148fbd4a82

	measure 'Delays this period' =
			
			VAR _d1 = [Period start]
			VAR _d2 = [Period end]
			VAR _t = [Reference time]
			RETURN
			    CALCULATE ( COUNTROWS ( FILTER ( FactFlight, FactFlight[DelayMin] > 15 ) ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] <= _t )
		formatString: 0
		displayFolder: 40 Flights
		lineageTag: 0baebadb-4205-522c-85e6-737a8cdf30c4

	measure 'Cancellations this period' =
			
			VAR _d1 = [Period start]
			VAR _d2 = [Period end]
			RETURN
			    CALCULATE ( COUNTROWS ( FactCancellation ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) ) + 0
		formatString: 0
		displayFolder: 40 Flights
		lineageTag: 9e97c82f-a694-5a67-a10d-ff07a42e9379

	measure 'Operations this period' =
			
			[Flights this period] + [Cancellations this period]
		formatString: 0
		displayFolder: 40 Flights
		lineageTag: cbfd3dd9-a1a3-52cf-8b6c-f7748d4eef23

	measure 'On time share' =
			
			DIVIDE ( [Flights this period] - [Delays this period], [Operations this period] )
		formatString: 0%
		displayFolder: 40 Flights
		lineageTag: bb79b80c-7a88-55cf-9a98-f15825f7637d

	measure 'Delayed share' =
			
			DIVIDE ( [Delays this period], [Operations this period] )
		formatString: 0%
		displayFolder: 40 Flights
		lineageTag: a291b002-30af-5a5b-be4c-48fce42b5f75

	measure 'Cancelled share' =
			
			DIVIDE ( [Cancellations this period], [Operations this period] )
		formatString: 0%
		displayFolder: 40 Flights
		lineageTag: 72814c81-de34-5d5f-9a4f-f848c026257a

	measure 'Page background flights (SVG)' =
			
			VAR _c_card = [Color card]
			VAR _c_hairline = [Color hairline]
			VAR _c_page = [Color page]
			VAR _c_sidebar = [Color sidebar]
			VAR _c_togglebg = [Color togglebg]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1440' height='872' viewBox='0 0 1440 872'><rect width='1440' height='872' fill='" & _c_page & "'/><rect width='216.7' height='872' fill='" & _c_sidebar & "'/><rect x='215.7' width='1' height='872' fill='" & _c_hairline & "'/><rect x='238.5' y='101.9' width='549.5' height='210.5' rx='17' fill='" & _c_card & "'/><rect x='808' y='101.9' width='190.1' height='210.5' rx='17' fill='" & _c_card & "'/><rect x='1018.1' y='101.9' width='190.1' height='210.5' rx='17' fill='" & _c_card & "'/><rect x='1228.1' y='101.9' width='190.1' height='210.5' rx='17' fill='" & _c_card & "'/><rect x='238.5' y='332.4' width='451.7' height='321.9' rx='17' fill='" & _c_card & "'/><rect x='710.2' y='332.4' width='375.3' height='321.9' rx='17' fill='" & _c_card & "'/><rect x='1105.5' y='332.4' width='312.7' height='159.4' rx='17' fill='" & _c_card & "'/><rect x='1105.5' y='511.9' width='312.7' height='142.5' rx='17' fill='" & _c_card & "'/><rect x='238.5' y='674.4' width='451.7' height='175.7' rx='17' fill='" & _c_card & "'/><rect x='710.2' y='674.4' width='375.3' height='175.7' rx='17' fill='" & _c_card & "'/><rect x='1105.5' y='674.4' width='312.7' height='175.7' rx='17' fill='" & _c_card & "'/><rect x='15.8' y='792.7' width='190' height='51.5' rx='25.75' fill='" & _c_togglebg & "'/><rect x='600' y='31' width='296' height='40' rx='20' fill='" & _c_togglebg & "'/></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: 1551350b-1464-5367-8718-7a2070eb6ef8
		dataCategory: ImageUrl

	measure 'Flights hero (SVG)' =
			
			VAR _ref = [Reference time]
			VAR _txt = FORMAT ( [Flights this period], "#,0" )
			VAR _xv = 40 + LEN ( _txt ) * 38 + 18
			VAR _chg = [Flights change]
			VAR _dref = [Reference date]
			VAR _m0 = [Month start]
			VAR _p = [Selected period]
			VAR _n = SWITCH ( _p, "Today", 7, "Week", 6, "Year", MONTH ( _dref ), 6 )
			VAR _per = ADDCOLUMNS ( GENERATESERIES ( 1, _n ),
			    "@d1", SWITCH ( _p, "Today", _dref - _n + [Value], "Week", _dref - 7 * ( _n - [Value] ) - 6,
			        "Year", DATE ( YEAR ( _dref ), [Value], 1 ), EDATE ( _m0, [Value] - _n ) ),
			    "@d2", SWITCH ( _p, "Today", _dref - _n + [Value], "Week", _dref - 7 * ( _n - [Value] ),
			        "Year", MIN ( EOMONTH ( DATE ( YEAR ( _dref ), [Value], 1 ), 0 ), _dref ), MIN ( EOMONTH ( EDATE ( _m0, [Value] - _n ), 0 ), _dref ) ) )
			VAR _perl = ADDCOLUMNS ( _per, "@lib", SWITCH ( _p, "Today", LEFT ( FORMAT ( [@d1], "ddd", "en-US" ), 2 ),
			    "Week", FORMAT ( WEEKNUM ( [@d2], 21 ), "0" ), "Year", LEFT ( FORMAT ( [@d1], "mmm", "en-US" ), 1 ), FORMAT ( [@d1], "mmm", "en-US" ) ) )
			VAR _moy = ADDCOLUMNS ( _perl, "@v", VAR _a = [@d1] VAR _b = [@d2] RETURN
			    DIVIDE ( CALCULATE ( COUNTROWS ( FactFlight ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _a, _b ), FactFlight[TakeOff] <= _ref ), _b - _a + 1 ) )
			VAR _max = MAXX ( _moy, [@v] )
			VAR _bw = MIN ( 13, 190 / _n * 0.55 ) VAR _pas = ( 190 - _bw ) / MAX ( _n - 1, 1 )
			VAR _barres = CONCATENATEX ( _moy,
			    VAR _i = [Value] - 1 VAR _h = DIVIDE ( [@v], _max ) * 46 VAR _x = 44 + _i * _pas
			    RETURN "<rect x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='208' width='" & FORMAT ( _bw, "0.0", "en-US" ) & "' height='0' rx='2'
			        fill='" & IF ( [Value] = _n, "#C89C50", "#F1E3C6" ) & "' fill-opacity='" & IF ( [Value] = _n, "1", "0.75" ) & "'>"
			        & "<animate attributeName='height' from='0' to='" & FORMAT ( _h, "0.0", "en-US" ) & "' begin='" & FORMAT ( _i * 0.07, "0.00", "en-US" ) & "s' dur='0.6s' fill='freeze'/>"
			        & "<animate attributeName='y' from='208' to='" & FORMAT ( 208 - _h, "0.0", "en-US" ) & "' begin='" & FORMAT ( _i * 0.07, "0.00", "en-US" ) & "s' dur='0.6s' fill='freeze'/></rect>"
			        & "<text x='" & FORMAT ( _x + _bw / 2, "0.0", "en-US" ) & "' y='226' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#FFFFFF' fill-opacity='0.85'>" & [@lib] & "</text>",
			    "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='549.5' height='210.5' viewBox='0 0 624 239' preserveAspectRatio='none'><defs><linearGradient id='hg' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#000000' stop-opacity='0.55'/><stop offset='0.62' stop-color='#000000' stop-opacity='0'/></linearGradient></defs><rect width='624' height='239' rx='19.3' fill='url(#hg)'/><text x='44' y='62' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='#FFFFFF' text-anchor='start' letter-spacing='3' fill-opacity='0.9'>TOTAL FLIGHTS</text><text x='40' y='146' font-family='Segoe UI, Arial, sans-serif' font-size='68' font-weight='700' fill='#FFFFFF'>"
			        & _txt
			        & "</text><text y='120' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' x='"
			        & FORMAT ( _xv, "0.0", "en-US" )
			        & "' fill='"
			        & IF ( _chg >= 0, "#7EE0A4", "#F59A93" )
			        & "'>"
			        & [Flights change label]
			        & "</text><text y='144' font-family='Segoe UI, Arial, sans-serif' font-size='14' fill='#FFFFFF' fill-opacity='0.85' x='"
			        & FORMAT ( _xv, "0.0", "en-US" )
			        & "'>"
			        & [Period phrase]
			        & "</text>"
			        & _barres
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: e7e4f186-b281-5463-8e94-3f9c4673a028
		dataCategory: ImageUrl

	measure 'Flights KPI duration (SVG)' =
			
			VAR _c_barlight = [Color barlight]
			VAR _c_iconbg = [Color iconbg]
			VAR _c_ink = [Color ink]
			VAR _c_kpitrack = [Color kpitrack]
			VAR _c_muted = [Color muted]
			VAR _ref = [Reference time]
			VAR _d2 = [Reference date]
			VAR _p = [Selected period]
			VAR _d1 = SWITCH ( _p, "Year", DATE ( YEAR ( _d2 ), 1, 1 ), "Month", _d2 - 55, _d2 - 27 )
			VAR _jour = WEEKDAY ( _d2, 2 )
			VAR _jours = ADDCOLUMNS ( GENERATESERIES ( 1, 7 ),
			    "@lo", VAR _w = [Value] RETURN CALCULATE ( PERCENTILEX.INC ( FactFlight, FactFlight[DurationMin], 0.25 ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), DimDate[WeekdayNum] = _w, FactFlight[TakeOff] <= _ref ),
			    "@hi", VAR _w = [Value] RETURN CALCULATE ( PERCENTILEX.INC ( FactFlight, FactFlight[DurationMin], 0.75 ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), DimDate[WeekdayNum] = _w, FactFlight[TakeOff] <= _ref ) )
			VAR _max = MAXX ( _jours, [@hi] ) * 1.1
			VAR _barres = CONCATENATEX ( _jours,
			    VAR _i = [Value] - 1 VAR _x = 25 + _i * 27
			    VAR _y1 = 214 - [@hi] / _max * 64 VAR _y0 = 214 - [@lo] / _max * 64 VAR _mid = ( _y0 + _y1 ) / 2
			    RETURN "<rect x='" & _x & "' y='150' width='8' height='64' rx='4' fill='" & _c_kpitrack & "'/>"
			        & "<rect x='" & _x & "' y='" & FORMAT ( _mid, "0.0", "en-US" ) & "' width='8' height='0' rx='4' fill='"
			        & IF ( _p = "Today" && [Value] <> _jour, "" & _c_barlight & "", "#C89C50" ) & "'>"
			        & "<animate attributeName='y' from='" & FORMAT ( _mid, "0.0", "en-US" ) & "' to='" & FORMAT ( _y1, "0.0", "en-US" ) & "' begin='" & FORMAT ( _i * 0.07, "0.00", "en-US" ) & "s' dur='0.6s' fill='freeze'/>"
			        & "<animate attributeName='height' from='0' to='" & FORMAT ( _y0 - _y1, "0.0", "en-US" ) & "' begin='" & FORMAT ( _i * 0.07, "0.00", "en-US" ) & "s' dur='0.6s' fill='freeze'/></rect>"
			        & "<text x='" & ( _x + 4 ) & "' y='232' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='" & _c_muted & "'>"
			        & SWITCH ( [Value], 1, "Mo", 2, "Tu", 3, "We", 4, "Th", 5, "Fr", 6, "Sa", "Su" ) & "</text>",
			    "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='190.1' height='210.5' viewBox='0 0 216 239' preserveAspectRatio='none'><circle cx='52' cy='58' r='31' fill='" & _c_iconbg & "'/><g transform='translate(39 45) scale(1.08333)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10' /><path d='M12 6v6l4 2' /></g><text x='100' y='48' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Average flight</text><text x='100' y='68' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>duration</text><text x='100' y='110' font-family='Segoe UI, Arial, sans-serif'><tspan font-size='29' font-weight='600' fill='" & _c_ink & "'>"
			        & [Avg duration label]
			        & "</tspan></text><text x='100' y='135' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='"
			        & [Avg duration change color]
			        & "'>"
			        & [Avg duration change label]
			        & "</text>"
			        & _barres
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: adb5e78e-9bc2-53d8-8fba-e8741e94531f
		dataCategory: ImageUrl

	measure 'Flights KPI distance (SVG)' =
			
			VAR _c_iconbg = [Color iconbg]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _ref = [Reference time]
			VAR _d2 = [Reference date]
			VAR _p = [Selected period]
			VAR _b = SWITCH ( _p, "Today", 1, "Week", 7, "Year", 48, 4 )
			VAR _pts = ADDCOLUMNS ( GENERATESERIES ( 0, 5 ), "@fin", _d2 - ( 5 - [Value] ) * _b,
			    "@v", VAR _f = _d2 - ( 5 - [Value] ) * _b RETURN CALCULATE ( AVERAGE ( FactFlight[DistanceKm] ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _f - _b + 1, _f ), FactFlight[TakeOff] <= _ref ) )
			VAR _min = MINX ( _pts, [@v] ) VAR _max = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pts, "@x", 30 + [Value] * 31, "@y", 205 - DIVIDE ( [@v] - _min, _max - _min ) * 52 )
			VAR _ligne = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y], "0.0", "en-US" ), " ", [Value], ASC )
			VAR _points = CONCATENATEX ( _xy,
			    "<circle cx='" & FORMAT ( [@x], "0.0", "en-US" ) & "' cy='" & FORMAT ( [@y], "0.0", "en-US" ) & "' r='0' fill='#C89C50'>"
			        & "<animate attributeName='r' from='0' to='5' begin='" & FORMAT ( 0.3 + [Value] * 0.12, "0.00", "en-US" ) & "s' dur='0.35s' fill='freeze'/></circle>"
			        & "<text x='" & FORMAT ( [@x], "0.0", "en-US" ) & "' y='232' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='" & IF ( _p = "Year", "10", "11" )
			        & "' fill='" & _c_muted & "'>" & IF ( _p = "Year", FORMAT ( [@fin], "mmm", "en-US" ), FORMAT ( [@fin], "dd" ) ) & "</text>",
			    "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='190.1' height='210.5' viewBox='0 0 216 239' preserveAspectRatio='none'><circle cx='52' cy='58' r='31' fill='" & _c_iconbg & "'/><g transform='translate(39 45) scale(1.08333)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='6' cy='19' r='3' /><path d='M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15' /><circle cx='18' cy='5' r='3' /></g><text x='100' y='48' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Average distance</text><text x='100' y='90' font-family='Segoe UI, Arial, sans-serif'><tspan font-size='29' font-weight='600' fill='" & _c_ink & "'>"
			        & FORMAT ( [Avg distance this period], "#,0" )
			        & "</tspan><tspan font-size='17' font-weight='600' fill='" & _c_ink & "'> km</tspan></text><text x='100' y='115' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='"
			        & [Avg distance change color]
			        & "'>"
			        & [Avg distance change label]
			        & "</text><line x1='22' y1='215' x2='194' y2='215' stroke='" & _c_line & "' stroke-width='1'/><polyline points='"
			        & _ligne
			        & "' fill='none' stroke='#D9BE86' stroke-width='1.6' stroke-dasharray='3 3' opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.2s' dur='0.8s' fill='freeze'/></polyline>"
			        & _points
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: d79c63ed-f7a5-5715-a292-ceb3facad044
		dataCategory: ImageUrl

	measure 'Flights KPI passengers (SVG)' =
			
			VAR _c_iconbg = [Color iconbg]
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _ref = [Reference time]
			VAR _dref = [Reference date]
			VAR _m0 = [Month start]
			VAR _p = [Selected period]
			VAR _n = SWITCH ( _p, "Today", 7, "Week", 6, "Year", MONTH ( _dref ), 6 )
			VAR _per = ADDCOLUMNS ( GENERATESERIES ( 1, _n ),
			    "@d1", SWITCH ( _p, "Today", _dref - _n + [Value], "Week", _dref - 7 * ( _n - [Value] ) - 6,
			        "Year", DATE ( YEAR ( _dref ), [Value], 1 ), EDATE ( _m0, [Value] - _n ) ),
			    "@d2", SWITCH ( _p, "Today", _dref - _n + [Value], "Week", _dref - 7 * ( _n - [Value] ),
			        "Year", MIN ( EOMONTH ( DATE ( YEAR ( _dref ), [Value], 1 ), 0 ), _dref ), MIN ( EOMONTH ( EDATE ( _m0, [Value] - _n ), 0 ), _dref ) ) )
			VAR _perl = ADDCOLUMNS ( _per, "@lib", SWITCH ( _p, "Today", LEFT ( FORMAT ( [@d1], "ddd", "en-US" ), 2 ),
			    "Week", FORMAT ( WEEKNUM ( [@d2], 21 ), "0" ), "Year", LEFT ( FORMAT ( [@d1], "mmm", "en-US" ), 1 ), FORMAT ( [@d1], "mmm", "en-US" ) ) )
			VAR _som = ADDCOLUMNS ( _perl, "@v", VAR _a = [@d1] VAR _b = [@d2] RETURN
			    CALCULATE ( SUM ( FactFlight[Passengers] ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _a, _b ), FactFlight[TakeOff] <= _ref ) + 0 )
			VAR _max = MAXX ( _som, [@v] ) VAR _min = MINX ( _som, [@v] )
			VAR _xy = ADDCOLUMNS ( _som, "@x", 16 + ( [Value] - 1 ) * 184 / MAX ( _n - 1, 1 ), "@y", 208 - DIVIDE ( [@v] - _min * 0.6, _max - _min * 0.6 ) * 62 )
			VAR _nb = COUNTROWS ( _xy )
			VAR _pt = ADDCOLUMNS ( _xy, "@xn", VAR _k = [Value] RETURN MAXX ( FILTER ( _xy, [Value] = _k + 1 ), [@x] ),
			    "@yn", VAR _k = [Value] RETURN MAXX ( FILTER ( _xy, [Value] = _k + 1 ), [@y] ) )
			VAR _x0 = MINX ( FILTER ( _pt, [Value] = 1 ), [@x] ) VAR _y0 = MINX ( FILTER ( _pt, [Value] = 1 ), [@y] )
			VAR _xn = MINX ( FILTER ( _pt, [Value] = _nb ), [@x] ) VAR _yn = MINX ( FILTER ( _pt, [Value] = _nb ), [@y] )
			VAR _chemin = "M" & FORMAT ( _x0, "0.0", "en-US" ) & "," & FORMAT ( _y0, "0.0", "en-US" ) & CONCATENATEX ( FILTER ( _pt, [Value] < _nb ),
			    IF ( [Value] = 1, "", " Q" & FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y], "0.0", "en-US" ) & " " ) & IF ( [Value] = 1, " L", "" )
			    & FORMAT ( ( [@x] + [@xn] ) / 2, "0.0", "en-US" ) & "," & FORMAT ( ( [@y] + [@yn] ) / 2, "0.0", "en-US" ), "", [Value], ASC )
			    & " L" & FORMAT ( _xn, "0.0", "en-US" ) & "," & FORMAT ( _yn, "0.0", "en-US" )
			VAR _libs = CONCATENATEX ( _xy, "<text x='" & FORMAT ( [@x], "0.0", "en-US" ) & "' y='232' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='" & IF ( _n > 7, "10", "11" ) & "' fill='" & _c_muted & "'>" & [@lib] & "</text>", "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='190.1' height='210.5' viewBox='0 0 216 239' preserveAspectRatio='none'><circle cx='52' cy='58' r='31' fill='" & _c_iconbg & "'/><g transform='translate(39 45) scale(1.08333)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' /><path d='M16 3.128a4 4 0 0 1 0 7.744' /><path d='M22 21v-2a4 4 0 0 0-3-3.87' /><circle cx='9' cy='7' r='4' /></g><text x='100' y='48' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Passengers</text><text x='100' y='90' font-family='Segoe UI, Arial, sans-serif'><tspan font-size='29' font-weight='600' fill='" & _c_ink & "'>"
			        & FORMAT ( [Passengers this period], "#,0" )
			        & "</tspan></text><text x='100' y='115' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='"
			        & [Passengers change color]
			        & "'>"
			        & [Passengers change label]
			        & "</text><defs><linearGradient id='pa' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#C89C50' stop-opacity='0.35'/><stop offset='1' stop-color='#C89C50' stop-opacity='0'/></linearGradient></defs><path d='"
			        & _chemin & " L" & FORMAT ( _xn, "0.0", "en-US" ) & ",214 L" & FORMAT ( _x0, "0.0", "en-US" ) & ",214 Z"
			        & "' fill='url(#pa)' opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.3s' dur='0.8s' fill='freeze'/></path><path d='"
			        & _chemin
			        & "' fill='none' stroke='#C89C50' stroke-width='2.2' stroke-linecap='round' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'><animate attributeName='stroke-dashoffset' from='1' to='0' dur='1.2s' fill='freeze'/></path>"
			        & _libs
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: d15e86f1-3935-5fec-b563-7726cc5187e5
		dataCategory: ImageUrl

	measure 'Flights upcoming (SVG)' =
			
			VAR _c_badge = [Color badge]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_thead = [Color thead]
			VAR _c_tile = [Color tile]
			VAR _s = [Selected flight status]
			VAR _d0 = [Reference date]
			VAR _fen = CALCULATETABLE ( FactFlight, REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _d0, _d0 + 1 ) )
			VAR _nall = COUNTROWS ( _fen ) + 0
			VAR _nprog = COUNTROWS ( FILTER ( _fen, FactFlight[Status] = "In progress" ) ) + 0
			VAR _nsch = COUNTROWS ( FILTER ( _fen, FactFlight[Status] = "Scheduled" ) ) + 0
			VAR _ndone = COUNTROWS ( FILTER ( _fen, FactFlight[Status] = "Landed" ) ) + 0
			VAR _sel = FILTER ( _fen, _s = "All" || FactFlight[Status] = IF ( _s = "Completed", "Landed", _s ) )
			VAR _top = TOPN ( 6, _sel, FactFlight[TakeOff], ASC )
			VAR _rang = ADDCOLUMNS ( _top, "@i", VAR _k = FactFlight[TakeOff] + FactFlight[FlightID] / 1000000 RETURN
			    COUNTROWS ( FILTER ( _top, FactFlight[TakeOff] + FactFlight[FlightID] / 1000000 <= _k ) ) )
			VAR _lignes = CONCATENATEX ( _rang, VAR _y = 154 + ( [@i] - 1 ) * 35 VAR _st = FactFlight[Status]
			    VAR _lib = SWITCH ( _st, "In progress", "In progress", "Scheduled", "Scheduled", "Landed", "Completed", _st )
			    VAR _c = SWITCH ( _st, "In progress", "#2F9E5B", "Scheduled", "#E0B252", "Landed", "#8C8C8C", "#8C8C8C" )
			    RETURN "<g transform='translate(0," & _y & ")' opacity='0'>"
			        & "<animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( [@i] * 0.06, "0.00", "en-US" ) & "s' dur='0.4s' fill='freeze'/>"
			        & "<g transform='translate(22 -13)'><g transform='translate(0 0) scale(0.708333) rotate(45 12 12)' fill='#C89C50' stroke='#C89C50' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z' /></g></g>"
			        & "<text x='48' y='0' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "'>" & FactFlight[FlightNo] & "</text>"
			        & "<text x='124' y='0' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>" & FactFlight[Origin] & " → " & FactFlight[Destination] & "</text>"
			        & "<text x='228' y='0' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>" & FORMAT ( FactFlight[Date], "dd mmm", "en-US" ) & "</text>"
			        & "<text x='300' y='0' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>" & FORMAT ( FactFlight[TakeOff], "hh:nn" ) & "</text>"
			        & "<circle cx='390' cy='-4.5' r='4.5' fill='" & _c & "'/>"
			        & "<text x='401' y='0' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>" & _lib & "</text>"
			        & IF ( [@i] < COUNTROWS ( _top ), "<rect x='22' y='16' width='469' height='1' fill='" & _c_line & "'/>" ) & "</g>",
			    "", [@i], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='451.7' height='321.9' viewBox='0 0 513 366' preserveAspectRatio='none'><text x='22' y='42' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Upcoming Flights</text><text x='491' y='40' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='#C89C50' text-anchor='end'>See all</text><rect x='22' y='58' width='109.75' height='34' rx='17' fill='"
			        & IF ( _s = "All", "#C89C50", "" & _c_tile & "" )
			        & "' stroke='"
			        & IF ( _s = "All", "#C89C50", "" & _c_line & "" )
			        & "' stroke-width='1'/><text x='35' y='79.5' font-family='Segoe UI, Arial, sans-serif' font-size='12' fill='"
			        & IF ( _s = "All", "#FFFFFF", "" & _c_ink & "" )
			        & "'>All</text><circle cx='114.75' cy='75' r='10' fill='"
			        & IF ( _s = "All", "#FFFFFF", "" & _c_badge & "" )
			        & "'/><text x='114.75' y='79' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='600' fill='"
			        & IF ( _s = "All", "#191A21", "" & _c_ink & "" )
			        & "'>"
			        & _nall
			        & "</text><rect x='141.75' y='58' width='109.75' height='34' rx='17' fill='"
			        & IF ( _s = "In progress", "#C89C50", "" & _c_tile & "" )
			        & "' stroke='"
			        & IF ( _s = "In progress", "#C89C50", "" & _c_line & "" )
			        & "' stroke-width='1'/><text x='154.75' y='79.5' font-family='Segoe UI, Arial, sans-serif' font-size='12' fill='"
			        & IF ( _s = "In progress", "#FFFFFF", "" & _c_ink & "" )
			        & "'>In Progress</text><circle cx='234.5' cy='75' r='10' fill='"
			        & IF ( _s = "In progress", "#FFFFFF", "" & _c_badge & "" )
			        & "'/><text x='234.5' y='79' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='600' fill='"
			        & IF ( _s = "In progress", "#191A21", "" & _c_ink & "" )
			        & "'>"
			        & _nprog
			        & "</text><rect x='261.5' y='58' width='109.75' height='34' rx='17' fill='"
			        & IF ( _s = "Scheduled", "#C89C50", "" & _c_tile & "" )
			        & "' stroke='"
			        & IF ( _s = "Scheduled", "#C89C50", "" & _c_line & "" )
			        & "' stroke-width='1'/><text x='274.5' y='79.5' font-family='Segoe UI, Arial, sans-serif' font-size='12' fill='"
			        & IF ( _s = "Scheduled", "#FFFFFF", "" & _c_ink & "" )
			        & "'>Scheduled</text><circle cx='354.25' cy='75' r='10' fill='"
			        & IF ( _s = "Scheduled", "#FFFFFF", "" & _c_badge & "" )
			        & "'/><text x='354.25' y='79' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='600' fill='"
			        & IF ( _s = "Scheduled", "#191A21", "" & _c_ink & "" )
			        & "'>"
			        & _nsch
			        & "</text><rect x='381.25' y='58' width='109.75' height='34' rx='17' fill='"
			        & IF ( _s = "Completed", "#C89C50", "" & _c_tile & "" )
			        & "' stroke='"
			        & IF ( _s = "Completed", "#C89C50", "" & _c_line & "" )
			        & "' stroke-width='1'/><text x='394.25' y='79.5' font-family='Segoe UI, Arial, sans-serif' font-size='12' fill='"
			        & IF ( _s = "Completed", "#FFFFFF", "" & _c_ink & "" )
			        & "'>Completed</text><circle cx='474' cy='75' r='10' fill='"
			        & IF ( _s = "Completed", "#FFFFFF", "" & _c_badge & "" )
			        & "'/><text x='474' y='79' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='600' fill='"
			        & IF ( _s = "Completed", "#191A21", "" & _c_ink & "" )
			        & "'>"
			        & _ndone
			        & "</text><rect x='22' y='104' width='469' height='28' rx='6' fill='" & _c_thead & "'/><text x='26' y='122' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Flight</text><text x='124' y='122' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Route</text><text x='228' y='122' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Date</text><text x='300' y='122' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Departure</text><text x='385' y='122' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Status</text>"
			        & _lignes
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: a806db33-38ec-5412-bc2e-a2775d53bde1
		dataCategory: ImageUrl

	measure 'Flights destinations (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _p1 = [Period start]
			VAR _p2 = [Period end]
			VAR _t = [Reference time]
			VAR _r0 = ADDCOLUMNS ( CALCULATETABLE ( SUMMARIZE ( FactFlight, FactFlight[Origin], FactFlight[Destination] ), DATESBETWEEN ( DimDate[Date], _p1, _p2 ), FactFlight[TakeOff] <= _t ),
			    "@n", CALCULATE ( COUNTROWS ( FactFlight ), DATESBETWEEN ( DimDate[Date], _p1, _p2 ), FactFlight[TakeOff] <= _t ) )
			VAR _r1 = ADDCOLUMNS ( TOPN ( 14, _r0, [@n], DESC ),
			    "@lo1", LOOKUPVALUE ( DimAirport[Longitude], DimAirport[AirportCode], FactFlight[Origin] ), "@la1", LOOKUPVALUE ( DimAirport[Latitude], DimAirport[AirportCode], FactFlight[Origin] ),
			    "@lo2", LOOKUPVALUE ( DimAirport[Longitude], DimAirport[AirportCode], FactFlight[Destination] ), "@la2", LOOKUPVALUE ( DimAirport[Latitude], DimAirport[AirportCode], FactFlight[Destination] ) )
			VAR _geo = UNION ( SELECTCOLUMNS ( _r1, "@lo", [@lo1], "@la", [@la1] ), SELECTCOLUMNS ( _r1, "@lo", [@lo2], "@la", [@la2] ) )
			VAR _eu = FILTER ( _geo, [@lo] >= -12 && [@lo] <= 30 && [@la] >= 34 && [@la] <= 62 )
			VAR _lomin = COALESCE ( MINX ( _eu, [@lo] ), -2 ) VAR _lomax = COALESCE ( MAXX ( _eu, [@lo] ), 8 )
			VAR _lamin = COALESCE ( MINX ( _eu, [@la] ), 42 ) VAR _lamax = COALESCE ( MAXX ( _eu, [@la] ), 51 )
			VAR _cx = ( _lomin + _lomax ) / 2 VAR _cy = ( _lamin + _lamax ) / 2
			VAR _slo = MAX ( ( _lomax - _lomin ) * 1.16, 10 ) VAR _sla = MAX ( ( _lamax - _lamin ) * 1.24, 6 )
			VAR _kb = MIN ( 398 / _slo, 196 * 0.72 / _sla )
			VAR _kx = MIN ( 398 / _slo, _kb * 1.35 ) VAR _ky = MIN ( 196 * 0.72 / _sla, _kb * 1.35 )
			VAR _terre = "translate(" & FORMAT ( 213.0 + ( -35 - _cx ) * _kx, "0.0", "en-US" ) & " " & FORMAT ( 154.0 + ( _cy - 72 ) * _ky / 0.72, "0.0", "en-US" ) & ") scale(" & FORMAT ( _kx / 10, "0.0000", "en-US" ) & " " & FORMAT ( _ky / 10, "0.0000", "en-US" ) & ")"
			VAR _r2 = ADDCOLUMNS ( _r1, "@x1", ( 213.0 + ( [@lo1] - _cx ) * _kx ), "@y1", ( 154.0 + ( _cy - [@la1] ) * _ky / 0.72 ), "@x2", ( 213.0 + ( [@lo2] - _cx ) * _kx ), "@y2", ( 154.0 + ( _cy - [@la2] ) * _ky / 0.72 ) )
			VAR _nmax = MAXX ( _r2, [@n] )
			VAR _arcs = CONCATENATEX ( _r2, VAR _q = [@n] / _nmax
			    VAR _qx = ( [@x1] + [@x2] ) / 2 VAR _qy = MIN ( [@y1], [@y2] ) - 0.18 * ABS ( [@x2] - [@x1] ) - 6
			    RETURN "<path d='M" & FORMAT ( [@x1], "0.0", "en-US" ) & "," & FORMAT ( [@y1], "0.0", "en-US" ) & " Q" & FORMAT ( _qx, "0.0", "en-US" ) & "," & FORMAT ( _qy, "0.0", "en-US" )
			        & " " & FORMAT ( [@x2], "0.0", "en-US" ) & "," & FORMAT ( [@y2], "0.0", "en-US" ) & "' fill='none' stroke='#C89C50' stroke-width='" & FORMAT ( 1 + 1.6 * _q, "0.0", "en-US" )
			        & "' stroke-opacity='" & FORMAT ( 0.45 + 0.5 * _q, "0.00", "en-US" ) & "' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'>"
			        & "<animate attributeName='stroke-dashoffset' from='1' to='0' begin='" & FORMAT ( 0.6 * ( 1 - _q ), "0.00", "en-US" ) & "s' dur='1.1s' fill='freeze'/></path>",
			    "", [@n], ASC )
			VAR _aer = FILTER ( ADDCOLUMNS ( DimAirport, "@u", VAR _c = DimAirport[AirportCode] RETURN
