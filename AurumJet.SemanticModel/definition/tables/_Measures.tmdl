table _Measures
	lineageTag: 2cbbc06b-3c68-59b9-bf05-12ed20aa5926

	measure 'Reference time' =
			
			DATE ( 2026, 10, 15 ) + TIME ( 10, 43, 0 )
		formatString: dd/mm/yyyy hh:nn
		displayFolder: 00 Base
		lineageTag: 1efacd8a-e473-52d3-9cf6-1f0c35bb9fa3

	measure 'Reference date' =
			
			DATE ( 2026, 10, 15 )
		formatString: dd/mm/yyyy
		displayFolder: 00 Base
		lineageTag: 51b29ec8-c484-55d5-ab90-edf2b483b7cd

	measure 'Month start' =
			
			DATE ( YEAR ( [Reference date] ), MONTH ( [Reference date] ), 1 )
		formatString: dd/mm/yyyy
		displayFolder: 00 Base
		lineageTag: 26ea865f-2f37-52e9-bf9f-ebe12ca83500

	measure 'Flights departed' =
			
			VAR _t = [Reference time]
			RETURN CALCULATE ( COUNTROWS ( FactFlight ), FactFlight[TakeOff] <= _t )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: bfad6c7a-c83e-59dc-9bc0-ea4c650bd478

	measure 'User first name' =
			
			"Claire"
		displayFolder: 00 Base
		lineageTag: d799200d-9c41-5b42-b2e4-7f766c810111

	measure 'User name' =
			
			"Claire Moreau"
		displayFolder: 00 Base
		lineageTag: a4491edf-d54d-5118-b008-b88a64961952

	measure 'User city' =
			
			"Paris, France"
		displayFolder: 00 Base
		lineageTag: f6022933-bc1d-532e-8e77-30aeedf94508

	measure Welcome =
			
			"Welcome back, " & [User first name] & "!"
		displayFolder: 00 Base
		lineageTag: 11b9f89a-ecd0-5564-a1a8-052db6ef13e8

	measure 'Landed today' =
			
			VAR _t = [Reference time]
			VAR _d = [Reference date]
			RETURN
			    CALCULATE ( COUNTROWS ( FactFlight ), FactFlight[Date] = _d, FactFlight[Landing] <= _t ) + 0
		formatString: 0
		displayFolder: 00 Base
		lineageTag: da790da8-7a7c-597f-996c-1ae9ce6342df

	measure 'Welcome subtitle' =
			
			VAR _n = [Landed today]
			RETURN _n & IF ( _n = 1, " flight", " flights" ) & " landed today."
		displayFolder: 00 Base
		lineageTag: 572d56e7-a509-5852-95b7-e154b0f6b7a4

	measure 'Messages unread' =
			
			2
		formatString: 0
		displayFolder: 00 Base
		lineageTag: 59b839f0-f749-55f4-af75-0fb6eae4a850

	measure 'Active filters' =
			
			INT ( ISFILTERED ( DimModel[Model] ) ) + INT ( ISFILTERED ( FactFlight[Type] ) ) + INT ( ISFILTERED ( DimClient[Tier] ) ) + INT ( ISFILTERED ( FactFlight[Origin] ) ) + INT ( ISFILTERED ( FactFlight[Destination] ) )
		formatString: 0
		displayFolder: 00 Base
		lineageTag: fb4b9bc6-60f0-5895-9673-71366e862c31

	measure 'Selected period' =
			
			SELECTEDVALUE ( Period[Period], "Month" )
		displayFolder: 05 Period
		lineageTag: e57cf298-6b8d-57da-bdb4-f3718555bff0

	measure 'Period end' =
			
			[Reference date]
		formatString: dd/mm/yyyy
		displayFolder: 05 Period
		lineageTag: 555b1f42-c6a1-5452-9c5b-2b0d1a115664

	measure 'Period start' =
			
			VAR _r = [Reference date]
			RETURN SWITCH ( [Selected period], "Today", _r, "Week", _r - 6,
			    "Year", DATE ( YEAR ( _r ), 1, 1 ), DATE ( YEAR ( _r ), MONTH ( _r ), 1 ) )
		formatString: dd/mm/yyyy
		displayFolder: 05 Period
		lineageTag: 51242261-710f-5d14-8362-a6603de65e1e

	measure 'Previous start' =
			
			VAR _r = [Reference date]
			RETURN SWITCH ( [Selected period], "Today", _r - 1, "Week", _r - 13,
			    "Year", DATE ( YEAR ( _r ) - 1, 1, 1 ), EDATE ( DATE ( YEAR ( _r ), MONTH ( _r ), 1 ), -1 ) )
		formatString: dd/mm/yyyy
		displayFolder: 05 Period
		lineageTag: 323142d5-cc59-5cd7-8a1a-5504381fb5c5

	measure 'Previous end' =
			
			VAR _r = [Reference date]
			RETURN SWITCH ( [Selected period], "Today", _r - 1, "Week", _r - 7,
			    "Year", EDATE ( _r, -12 ), EDATE ( _r, -1 ) )
		formatString: dd/mm/yyyy
		displayFolder: 05 Period
		lineageTag: 06e7fd6f-b9c2-50a0-800f-e1ff0bb13651

	measure 'Period phrase' =
			
			SWITCH ( [Selected period], "Today", "today", "Week", "this week", "Year", "this year", "this month" )
		displayFolder: 05 Period
		lineageTag: afe64a66-2ab6-5487-9125-032ebaa1ad74

	measure 'Flights title' =
			
			"Flights " & [Period phrase]
		displayFolder: 05 Period
		lineageTag: 3beb98a4-a3b4-522d-aafb-ce84a00b188f

	measure 'Flights this period' =
			
			VAR _d1 = [Period start]
			VAR _d2 = [Period end]
			VAR _t = [Reference time]
			RETURN
			    CALCULATE ( COUNTROWS ( FactFlight ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] <= _t )
		formatString: #,0
		displayFolder: 10 KPI
		lineageTag: de5082b4-fbd8-592d-b98d-70c9a71cc935

	measure 'Flights previous period' =
			
			VAR _d1 = [Previous start]
			VAR _d2 = [Previous end]
			VAR _fin = _d2 + IF ( [Selected period] = "Month", 1, [Reference time] - [Reference date] )
			RETURN
			    CALCULATE ( COUNTROWS ( FactFlight ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] < _fin )
		formatString: #,0
		displayFolder: 10 KPI
		lineageTag: 58f218e6-dbab-58df-a9d6-29933bc0474a

	measure 'Flights change' =
			
			DIVIDE ( [Flights this period] - [Flights previous period], [Flights previous period] )
		formatString: 0 %
		displayFolder: 10 KPI
		lineageTag: 59b374a1-1df7-5170-9978-48561fdf94b1

	measure 'Flights change label' =
			
			VAR _c = [Flights change]
			RETURN
			    IF ( NOT ISBLANK ( _c ), IF ( _c >= 0, "↑ ", "↓ " ) & FORMAT ( ABS ( _c ), IF ( ABS ( _c ) < 0.0095, "0.0 %", "0 %" ), "en-US" ) )
		displayFolder: 10 KPI
		lineageTag: 4f4d2c05-19b4-586d-8f0f-48d32165a1e5

	measure 'Flights change color' =
			
			IF ( [Flights change] >= 0, "#2F9E5B", "#D9534F" )
		displayFolder: 10 KPI
		lineageTag: f662ec01-4654-597f-b41c-bf74ef19bb20

	measure 'Avg duration this period' =
			
			VAR _d1 = [Period start]
			VAR _d2 = [Period end]
			VAR _t = [Reference time]
			RETURN
			    CALCULATE ( AVERAGE ( FactFlight[DurationMin] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] <= _t )
		formatString: 0
		displayFolder: 10 KPI
		lineageTag: 090d3e12-1ebe-5a00-a7ce-d8d6ecd88a7c

	measure 'Avg duration previous period' =
			
			VAR _d1 = [Previous start]
			VAR _d2 = [Previous end]
			VAR _fin = _d2 + IF ( [Selected period] = "Month", 1, [Reference time] - [Reference date] )
			RETURN
			    CALCULATE ( AVERAGE ( FactFlight[DurationMin] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] < _fin )
		formatString: 0
		displayFolder: 10 KPI
		lineageTag: f17812c3-d97a-58a7-b429-38e0edb54037

	measure 'Avg duration change' =
			
			DIVIDE ( [Avg duration this period] - [Avg duration previous period], [Avg duration previous period] )
		formatString: 0 %
		displayFolder: 10 KPI
		lineageTag: 2ad727c3-6108-517c-9375-8272142941c5

	measure 'Avg duration change label' =
			
			VAR _c = [Avg duration change]
			RETURN
			    IF ( NOT ISBLANK ( _c ), IF ( _c >= 0, "↑ ", "↓ " ) & FORMAT ( ABS ( _c ), IF ( ABS ( _c ) < 0.0095, "0.0 %", "0 %" ), "en-US" ) )
		displayFolder: 10 KPI
		lineageTag: a48802c8-4fde-56a3-8b5c-3f90530a69aa

	measure 'Avg duration change color' =
			
			IF ( [Avg duration change] >= 0, "#2F9E5B", "#D9534F" )
		displayFolder: 10 KPI
		lineageTag: f0d7e9b7-714a-5de7-913f-de3255bda24a

	measure 'Avg duration label' =
			
			VAR _m = ROUND ( [Avg duration this period], 0 )
			RETURN
			    IF ( NOT ISBLANK ( _m ), INT ( _m / 60 ) & " h " & FORMAT ( MOD ( _m, 60 ), "00" ) )
		displayFolder: 10 KPI
		lineageTag: 0c19dda1-1cad-526d-aa96-0ad064d73b29

	measure 'Avg distance this period' =
			
			VAR _d1 = [Period start]
			VAR _d2 = [Period end]
			VAR _t = [Reference time]
			RETURN
			    CALCULATE ( AVERAGE ( FactFlight[DistanceKm] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] <= _t )
		formatString: #,0
		displayFolder: 10 KPI
		lineageTag: 7d2503b3-5612-5b5e-979f-91f6fc1c787d

	measure 'Avg distance previous period' =
			
			VAR _d1 = [Previous start]
			VAR _d2 = [Previous end]
			VAR _fin = _d2 + IF ( [Selected period] = "Month", 1, [Reference time] - [Reference date] )
			RETURN
			    CALCULATE ( AVERAGE ( FactFlight[DistanceKm] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] < _fin )
		formatString: #,0
		displayFolder: 10 KPI
		lineageTag: 23a86032-1096-5446-a623-6bdbee1a4ee5

	measure 'Avg distance change' =
			
			DIVIDE ( [Avg distance this period] - [Avg distance previous period], [Avg distance previous period] )
		formatString: 0 %
		displayFolder: 10 KPI
		lineageTag: 49d89428-abdb-518a-857d-6beb46eb39fa

	measure 'Avg distance change label' =
			
			VAR _c = [Avg distance change]
			RETURN
			    IF ( NOT ISBLANK ( _c ), IF ( _c >= 0, "↑ ", "↓ " ) & FORMAT ( ABS ( _c ), IF ( ABS ( _c ) < 0.0095, "0.0 %", "0 %" ), "en-US" ) )
		displayFolder: 10 KPI
		lineageTag: f09db5a0-6ec8-5a1c-8d1c-1c2786b00bd7

	measure 'Avg distance change color' =
			
			IF ( [Avg distance change] >= 0, "#2F9E5B", "#D9534F" )
		displayFolder: 10 KPI
		lineageTag: 14556ea9-31ba-5632-bf32-9fdb57ea01f3

	measure 'Avg distance label' =
			
			FORMAT ( [Avg distance this period], "#,0" ) & " km"
		displayFolder: 10 KPI
		lineageTag: 806b9035-08c7-5a43-8c76-0bbeee4c9f13

	measure 'Avg cruise speed' =
			
			VAR _d1 = [Period start]
			VAR _d2 = [Period end]
			VAR _t = [Reference time]
			RETURN
			    CALCULATE ( AVERAGE ( FactFlight[CruiseKnots] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] <= _t )
		formatString: 0
		displayFolder: 10 KPI
		lineageTag: b19cfda9-77b3-5d69-ab19-7766e171ae80

	measure 'Avg load' =
			
			VAR _d1 = [Period start]
			VAR _d2 = [Period end]
			VAR _t = [Reference time]
			RETURN
			    CALCULATE ( AVERAGEX ( FactFlight, DIVIDE ( FactFlight[Passengers], RELATED ( DimModel[Seats] ) ) ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] <= _t )
		formatString: 0 %
		displayFolder: 10 KPI
		lineageTag: 79814ea5-0b93-5bba-b8af-0cf883b99d16

	measure 'In-progress flight ID' =
			
			VAR _t = [Reference time]
			RETURN
			    CALCULATE ( MAX ( FactFlight[FlightID] ), REMOVEFILTERS ( FactFlight ), FactFlight[TakeOff] <= _t, FactFlight[Landing] > _t )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: c82769c3-efaa-5ee9-94e2-2d6c8838bb6f

	measure 'Current flight ID' =
			
			VAR _s = SELECTEDVALUE ( 'Flight picker'[FlightID] )
			RETURN IF ( NOT ISBLANK ( _s ), _s, [In-progress flight ID] )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: 5c80fd62-42f9-52b0-b429-aaed06dc52cc

	measure 'Current origin' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[Origin] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		displayFolder: 20 Current flight
		lineageTag: a70a7205-edd1-572b-a492-c3797f33fbb1

	measure 'Current destination' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[Destination] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		displayFolder: 20 Current flight
		lineageTag: b887cb42-4ed9-5d26-b4a0-1f16ca50ffab

	measure 'Current origin city' =
			
			LOOKUPVALUE ( DimAirport[City], DimAirport[AirportCode], [Current origin] )
		displayFolder: 20 Current flight
		lineageTag: 9c93c61f-06c6-55e8-ae9d-9ab29f497ee1

	measure 'Current destination city' =
			
			LOOKUPVALUE ( DimAirport[City], DimAirport[AirportCode], [Current destination] )
		displayFolder: 20 Current flight
		lineageTag: 00f091fb-e391-5a48-939c-c47f5096e680

	measure 'Current check-in time' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( FORMAT ( MAX ( FactFlight[CheckIn] ), "hh:nn" ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		displayFolder: 20 Current flight
		lineageTag: 6503c993-ed65-58dd-b9f4-dcb7f992668f

	measure 'Current boarding time' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( FORMAT ( MAX ( FactFlight[Boarding] ), "hh:nn" ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		displayFolder: 20 Current flight
		lineageTag: a0edc12d-a6be-5a88-aa3c-d482d912805b

	measure 'Current take-off time' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( FORMAT ( MAX ( FactFlight[TakeOff] ), "hh:nn" ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		displayFolder: 20 Current flight
		lineageTag: dbe05b2b-9485-5c2f-9400-e06f93e524de

	measure 'Current landing time' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( FORMAT ( MAX ( FactFlight[Landing] ), "hh:nn" ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		displayFolder: 20 Current flight
		lineageTag: 017e94e6-0173-53ca-9215-3a0880856e93

	measure 'Current passengers' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[Passengers] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: 65bf85f4-6b02-5114-aec4-fe8daf279298

	measure 'Current baggage' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[BaggageKg] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: 6a804c93-73cc-54fb-9d7a-0778de2fcd6f

	measure 'Current baggage label' =
			
			[Current baggage] & " kg"
		displayFolder: 20 Current flight
		lineageTag: 6eba6edb-2af3-5fc7-bba9-ff255209fc3b

	measure 'Current duration' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[DurationMin] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: bd02303d-4d33-53a8-b3f1-0b27bcab913a

	measure 'Current duration label' =
			
			VAR _m = ROUND ( [Current duration], 0 )
			RETURN
			    IF ( NOT ISBLANK ( _m ), INT ( _m / 60 ) & " h " & FORMAT ( MOD ( _m, 60 ), "00" ) )
		displayFolder: 20 Current flight
		lineageTag: b0831bdc-d7b9-51e8-b020-ae80928ab3bd

	measure 'Current type' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[Type] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		displayFolder: 20 Current flight
		lineageTag: e2223177-6a21-5f60-b20c-d969757d35bd

	measure 'Current status label' =
			
			VAR _t = [Reference time]
			VAR _id = [Current flight ID]
			VAR _dep = CALCULATE ( MAX ( FactFlight[TakeOff] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
			VAR _arr = CALCULATE ( MAX ( FactFlight[Landing] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
			RETURN IF ( NOT ISBLANK ( _id ), IF ( _t < _dep, "Scheduled", IF ( _t >= _arr, "Landed", "In progress" ) ) )
		displayFolder: 20 Current flight
		lineageTag: 176a8d7c-b3d5-5c93-901b-086ee94823a6

	measure 'Current client ID' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[ClientID] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: d8070f11-2836-5a08-9b8f-a6e6adcc732e

	measure 'Current client' =
			
			LOOKUPVALUE ( DimClient[Client], DimClient[ClientID], [Current client ID] )
		displayFolder: 20 Current flight
		lineageTag: 6cc82155-3c62-5a2c-9ba4-0094ef984d08

	measure 'Current client phone' =
			
			LOOKUPVALUE ( DimClient[Phone], DimClient[ClientID], [Current client ID] )
		displayFolder: 20 Current flight
		lineageTag: fef7ca8b-01ab-52b4-8592-8b61d32c4a85

	measure 'Current distance' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[DistanceKm] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		formatString: #,0
		displayFolder: 20 Current flight
		lineageTag: a939b0d5-5382-57e5-88fb-02b7bbe36bdb

	measure 'Current progress' =
			
			VAR _t = [Reference time]
			VAR _id = [Current flight ID]
			VAR _dep = CALCULATE ( MAX ( FactFlight[TakeOff] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
			VAR _arr = CALCULATE ( MAX ( FactFlight[Landing] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
			RETURN IF ( NOT ISBLANK ( _dep ), MIN ( MAX ( DIVIDE ( _t - _dep, _arr - _dep ), 0 ), 1 ) )
		formatString: 0 %
		displayFolder: 20 Current flight
		lineageTag: 796ec59a-2d1e-5575-98cf-fdb407ed0a99

	measure 'Current progress label' =
			
			VAR _s = [Current status label]
			RETURN SWITCH ( _s,
			    "Scheduled", "Departs at " & [Current take-off time], "Landed", "Landed at " & [Current landing time],
			    FORMAT ( [Current progress], "0%" ) & " completed" )
		displayFolder: 20 Current flight
		lineageTag: 0a11e4ba-e20a-58af-bf6d-d86fd5d5e329

	measure 'Current flown km' =
			
			ROUND ( [Current progress] * [Current distance], 0 )
		formatString: #,0
		displayFolder: 20 Current flight
		lineageTag: 6d18f290-fd12-5c60-b664-ae7f8235cb73

	measure 'Current cruise speed' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[CruiseKnots] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: 1dccf835-c49b-5e0c-8cf7-ad147cc2ba57

	measure 'Current aircraft ID' =
			
			VAR _id = [Current flight ID]
			RETURN
			    CALCULATE ( MAX ( FactFlight[AircraftID] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: 223e7f67-22c5-55e6-8db4-389f6011cecb

	measure 'Current model ID' =
			
			LOOKUPVALUE ( DimAircraft[ModelID], DimAircraft[AircraftID], [Current aircraft ID] )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: 517f51f5-8a72-5f20-a47f-55ae3dcde0b0

	measure 'Shown model ID' =
			
			VAR _c = SELECTEDVALUE ( 'Fleet picker'[ModelID] )
			RETURN IF ( NOT ISBLANK ( _c ), _c, [Current model ID] )
		formatString: 0
		displayFolder: 30 Fleet
		lineageTag: 9b733959-db76-5253-b521-1eba1e6230db

	measure 'Current seats' =
			
			LOOKUPVALUE ( DimModel[Seats], DimModel[ModelID], [Current model ID] )
		formatString: 0
		displayFolder: 20 Current flight
		lineageTag: fbc5e9a7-0680-5011-8b98-99a33cd3aa2c

	measure 'Current load' =
			
			DIVIDE ( [Current passengers], [Current seats] )
		formatString: 0 %
		displayFolder: 20 Current flight
		lineageTag: dd9a5c64-81d8-57be-8d2e-f49c065e929b

	measure 'Fleet utilization label' =
			
			FORMAT ( [Fleet utilization], "0 %" )
		displayFolder: 30 Fleet
		lineageTag: 1f489180-a767-5cff-87c6-7b50a43ab29d

	measure 'Fleet utilization' =
			
			VAR _m = [Shown model ID]
			VAR _d1 = [Period start]
			VAR _d2 = [Period end]
			VAR _t = [Reference time]
			VAR _n = CALCULATE ( COUNTROWS ( DimAircraft ), REMOVEFILTERS ( DimAircraft ), REMOVEFILTERS ( DimModel ), DimAircraft[ModelID] = _m )
			VAR _vols = CALCULATETABLE ( SUMMARIZE ( FactFlight, FactFlight[AircraftID], FactFlight[Date] ), REMOVEFILTERS ( DimAircraft ),
			    REMOVEFILTERS ( DimModel ), DimAircraft[ModelID] = _m, DATESBETWEEN ( DimDate[Date], _d1, _d2 ), FactFlight[TakeOff] <= _t )
			RETURN DIVIDE ( COUNTROWS ( _vols ), _n * ( _d2 - _d1 + 1 ) )
		formatString: 0 %
		displayFolder: 30 Fleet
		lineageTag: 9488c72f-ef6a-5023-9377-fabc59e89902

	measure 'Selected map mode' =
			
			SELECTEDVALUE ( 'Map mode'[Mode], "Live" )
		displayFolder: 30 Fleet
