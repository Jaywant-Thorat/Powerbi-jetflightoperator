	measure 'Nav flights (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='197' height='50' viewBox='0 0 197 50'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#CFA660'/><stop offset='1' stop-color='#A97C33'/></linearGradient></defs><g transform='translate(18 13) scale(1)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z' /></g><text x='61' y='31' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Flights</text></svg>"
