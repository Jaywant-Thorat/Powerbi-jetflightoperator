	measure 'KPI flights (SVG)' =
			
			VAR _c_barlight = [Color barlight]
			VAR _c_chip = [Color chip]
			VAR _c_chipicon = [Color chipicon]
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _ref = [Reference time]
			VAR _dref = [Reference date]
			VAR _m0 = [Month start]
			VAR _p = [Selected period]
			VAR _n = SWITCH ( _p, "Today", 7, "Week", 6, "Year", MONTH ( _dref ), 6 )
			VAR _per = ADDCOLUMNS ( GENERATESERIES ( 1, _n ),
			    "@d1", SWITCH ( _p, "Today", _dref - _n + [Value], "Week", _dref - 7 * ( _n - [Value] ) - 6,
			        "Year", DATE ( YEAR ( _dref ), [Value], 1 ), EDATE ( _m0, [Value] - _n ) ),
			    "@d2", SWITCH ( _p, "Today", _dref - _n + [Value], "Week", _dref - 7 * ( _n - [Value] ),
			        "Year", MIN ( EOMONTH ( DATE ( YEAR ( _dref ), [Value], 1 ), 0 ), _dref ), MIN ( EOMONTH ( EDATE ( _m0, [Value] - _n ), 0 ), _dref ) ) )
			VAR _moy = ADDCOLUMNS ( _per, "@v", VAR _a = [@d1] VAR _b = [@d2] RETURN
			    DIVIDE ( CALCULATE ( COUNTROWS ( FactFlight ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _a, _b ), FactFlight[TakeOff] <= _ref ), _b - _a + 1 ),
			    "@lib", SWITCH ( _p, "Today", LEFT ( FORMAT ( [@d1], "ddd", "en-US" ), 2 ), "Week", FORMAT ( WEEKNUM ( [@d2], 21 ), "0" ),
			        "Year", LEFT ( FORMAT ( [@d1], "mmm", "en-US" ), 1 ), FORMAT ( [@d1], "mmm", "en-US" ) ) )
			VAR _max = MAXX ( _moy, [@v] )
			VAR _bw = MIN ( 14, 110 / _n * 0.68 ) VAR _pas = ( 110 - _bw ) / MAX ( _n - 1, 1 )
			VAR _barres = CONCATENATEX ( _moy,
			    VAR _i = [Value] - 1 VAR _h = DIVIDE ( [@v], _max ) * 70 VAR _x = 227 + _i * _pas
			    RETURN "<rect x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='92' width='" & FORMAT ( _bw, "0.0", "en-US" )
			        & "' height='0' rx='3' fill='" & IF ( [Value] = _n, "#C89C50", "" & _c_barlight & "" ) & "'>"
			        & "<animate attributeName='height' from='0' to='" & FORMAT ( _h, "0.0", "en-US" ) & "' begin='" & FORMAT ( _i * 0.07, "0.00", "en-US" ) & "s' dur='0.6s' fill='freeze'/>"
			        & "<animate attributeName='y' from='92' to='" & FORMAT ( 92 - _h, "0.0", "en-US" ) & "' begin='" & FORMAT ( _i * 0.07, "0.00", "en-US" ) & "s' dur='0.6s' fill='freeze'/></rect>"
			        & "<text x='" & FORMAT ( _x + _bw / 2, "0.0", "en-US" ) & "' y='108' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='10' fill='" & _c_muted & "'>" & [@lib] & "</text>",
			    "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='347.6' height='118.7' viewBox='0 0 355 122' preserveAspectRatio='none'><text x='20' y='35' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_ink & "'>"
			        & [Flights title]
			        & "</text><circle cx='47' cy='76' r='27' fill='" & _c_chip & "'/><g transform='translate(35 64) scale(1)' fill='none' stroke='" & _c_chipicon & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z' /></g><text x='90' y='89' font-family='Segoe UI, Arial, sans-serif'><tspan font-size='"
			        & IF ( LEN ( FORMAT ( [Flights this period], "#,0" ) ) >= 5, "28", "34" )
			        & "' font-weight='600' fill='" & _c_ink & "'>"
			        & FORMAT ( [Flights this period], "#,0" )
			        & "</tspan><tspan dx='12' font-size='15' font-weight='600' fill='"
			        & [Flights change color]
			        & "'>"
			        & [Flights change label]
			        & "</tspan></text>"
			        & _barres
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 42698b2c-fbf7-5a00-ac30-a467377d060b
		dataCategory: ImageUrl

	measure 'KPI duration (SVG)' =
			
			VAR _c_barlight = [Color barlight]
			VAR _c_chip = [Color chip]
			VAR _c_chipicon = [Color chipicon]
			VAR _c_ink = [Color ink]
			VAR _c_kpitrack = [Color kpitrack]
			VAR _c_muted = [Color muted]
			VAR _ref = [Reference time]
			VAR _d2 = [Reference date]
			VAR _p = [Selected period]
			VAR _d1 = SWITCH ( _p, "Year", DATE ( YEAR ( _d2 ), 1, 1 ), "Month", _d2 - 55, _d2 - 27 )
			VAR _jour = WEEKDAY ( _d2, 2 )
			VAR _jours = ADDCOLUMNS ( GENERATESERIES ( 1, 7 ),
			    "@lo", VAR _w = [Value] RETURN CALCULATE ( PERCENTILEX.INC ( FactFlight, FactFlight[DurationMin], 0.25 ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), DimDate[WeekdayNum] = _w, FactFlight[TakeOff] <= _ref ),
			    "@hi", VAR _w = [Value] RETURN CALCULATE ( PERCENTILEX.INC ( FactFlight, FactFlight[DurationMin], 0.75 ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ), DimDate[WeekdayNum] = _w, FactFlight[TakeOff] <= _ref ) )
			VAR _max = MAXX ( _jours, [@hi] ) * 1.1
			VAR _barres = CONCATENATEX ( _jours,
			    VAR _i = [Value] - 1 VAR _x = 298 + _i * 22
			    VAR _y1 = 92 - [@hi] / _max * 72 VAR _y0 = 92 - [@lo] / _max * 72 VAR _mid = ( _y0 + _y1 ) / 2
			    RETURN "<rect x='" & _x & "' y='20' width='6' height='72' rx='3' fill='" & _c_kpitrack & "'/>"
			        & "<rect x='" & _x & "' y='" & FORMAT ( _mid, "0.0", "en-US" ) & "' width='6' height='0' rx='3' fill='"
			        & IF ( _p = "Today" && [Value] <> _jour, "" & _c_barlight & "", "#C89C50" ) & "'>"
			        & "<animate attributeName='y' from='" & FORMAT ( _mid, "0.0", "en-US" ) & "' to='" & FORMAT ( _y1, "0.0", "en-US" ) & "' begin='" & FORMAT ( _i * 0.07, "0.00", "en-US" ) & "s' dur='0.6s' fill='freeze'/>"
			        & "<animate attributeName='height' from='0' to='" & FORMAT ( _y0 - _y1, "0.0", "en-US" ) & "' begin='" & FORMAT ( _i * 0.07, "0.00", "en-US" ) & "s' dur='0.6s' fill='freeze'/></rect>"
			        & "<text x='" & ( _x + 3 ) & "' y='108' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='10' fill='" & _c_muted & "'>"
			        & SWITCH ( [Value], 1, "Mo", 2, "Tu", 3, "We", 4, "Th", 5, "Fr", 6, "Sa", "Su" ) & "</text>",
			    "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='444.5' height='118.7' viewBox='0 0 454 122' preserveAspectRatio='none'><text x='20' y='35' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Average flight duration</text><circle cx='47' cy='76' r='27' fill='" & _c_chip & "'/><g transform='translate(35 64) scale(1)' fill='none' stroke='" & _c_chipicon & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10' /><path d='M12 6v6l4 2' /></g><text x='90' y='89' font-family='Segoe UI, Arial, sans-serif'><tspan font-size='34' font-weight='600' fill='" & _c_ink & "'>"
			        & [Avg duration label]
			        & "</tspan><tspan dx='12' font-size='15' font-weight='600' fill='"
			        & [Avg duration change color]
			        & "'>"
			        & [Avg duration change label]
			        & "</tspan></text>"
			        & _barres
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 12fbd577-0c30-52e1-abd5-06e21975c90e
		dataCategory: ImageUrl

	measure 'KPI distance (SVG)' =
			
			VAR _c_chip = [Color chip]
			VAR _c_chipicon = [Color chipicon]
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _ref = [Reference time]
			VAR _d2 = [Reference date]
			VAR _p = [Selected period]
			VAR _b = SWITCH ( _p, "Today", 1, "Week", 7, "Year", 48, 4 )
			VAR _pts = ADDCOLUMNS ( GENERATESERIES ( 0, 5 ), "@fin", _d2 - ( 5 - [Value] ) * _b,
			    "@v", VAR _f = _d2 - ( 5 - [Value] ) * _b RETURN CALCULATE ( AVERAGE ( FactFlight[DistanceKm] ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _f - _b + 1, _f ), FactFlight[TakeOff] <= _ref ) )
			VAR _min = MINX ( _pts, [@v] ) VAR _max = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pts, "@x", 245 + [Value] * 18, "@y", 86 - DIVIDE ( [@v] - _min, _max - _min ) * 60 )
			VAR _ligne = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y], "0.0", "en-US" ), " ", [Value], ASC )
			VAR _points = CONCATENATEX ( _xy,
			    "<circle cx='" & FORMAT ( [@x], "0.0", "en-US" ) & "' cy='" & FORMAT ( [@y], "0.0", "en-US" ) & "' r='0' fill='#C89C50'>"
			        & "<animate attributeName='r' from='0' to='4.5' begin='" & FORMAT ( 0.3 + [Value] * 0.12, "0.00", "en-US" ) & "s' dur='0.35s' fill='freeze'/></circle>"
			        & "<text x='" & FORMAT ( [@x], "0.0", "en-US" ) & "' y='108' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='" & IF ( _p = "Year", "9", "10" )
			        & "' fill='" & _c_muted & "'>" & IF ( _p = "Year", FORMAT ( [@fin], "mmm", "en-US" ), FORMAT ( [@fin], "dd" ) ) & "</text>",
			    "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='347.6' height='118.7' viewBox='0 0 355 122' preserveAspectRatio='none'><text x='20' y='35' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Average distance</text><circle cx='47' cy='76' r='27' fill='" & _c_chip & "'/><g transform='translate(35 64) scale(1)' fill='none' stroke='" & _c_chipicon & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='6' cy='19' r='3' /><path d='M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15' /><circle cx='18' cy='5' r='3' /></g><text x='90' y='89' font-family='Segoe UI, Arial, sans-serif'><tspan font-size='"
			        & IF ( LEN ( FORMAT ( [Avg distance this period], "#,0" ) ) >= 5, "28", "34" )
			        & "' font-weight='600' fill='" & _c_ink & "'>"
			        & FORMAT ( [Avg distance this period], "#,0" )
			        & "</tspan><tspan font-size='20' font-weight='600' fill='" & _c_ink & "'> km</tspan><tspan dx='12' font-size='15' font-weight='600' fill='"
			        & [Avg distance change color]
			        & "'>"
			        & [Avg distance change label]
			        & "</tspan></text><polyline points='"
			        & _ligne
			        & "' fill='none' stroke='#D9BE86' stroke-width='1.5' stroke-dasharray='3 3' opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.2s' dur='0.8s' fill='freeze'/></polyline>"
			        & _points
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 5e5d3842-6ef8-5fde-a62a-0c6a2cff6ed4
		dataCategory: ImageUrl

	measure 'Flight details (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='347.6' height='264.5' viewBox='0 0 355 271' preserveAspectRatio='none'><text x='20' y='37' font-family='Segoe UI, Arial, sans-serif' font-size='21' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Flight Details</text><text x='20' y='59' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_muted & "'>"
			        & [Current type]
			        & " &#160;|&#160; "
			        & [Current status label]
			        & "</text><rect x='20' y='68' width='97' height='84' rx='12' fill='" & _c_tile & "'/><g transform='translate(57.5 77) scale(0.916667)' fill='none' stroke='#C89C50' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' /><path d='M16 3.128a4 4 0 0 1 0 7.744' /><path d='M22 21v-2a4 4 0 0 0-3-3.87' /><circle cx='9' cy='7' r='4' /></g><text x='68.5' y='121' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='600' fill='" & _c_ink & "' text-anchor='middle'>"
			        & [Current passengers]
			        & "</text><text x='68.5' y='140' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>passengers</text><rect x='131' y='68' width='97' height='84' rx='12' fill='" & _c_tile & "'/><g transform='translate(168.5 77) scale(0.916667)' fill='none' stroke='#C89C50' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M6 20a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2' /><path d='M8 18V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v14' /><path d='M10 20h4' /><circle cx='16' cy='20' r='2' /><circle cx='8' cy='20' r='2' /></g><text x='179.5' y='121' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='600' fill='" & _c_ink & "' text-anchor='middle'>"
			        & [Current baggage label]
			        & "</text><text x='179.5' y='140' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>baggage</text><rect x='242' y='68' width='97' height='84' rx='12' fill='" & _c_tile & "'/><g transform='translate(279.5 77) scale(0.916667)' fill='none' stroke='#C89C50' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10' /><path d='M12 6v6l4 2' /></g><text x='290.5' y='121' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='600' fill='" & _c_ink & "' text-anchor='middle'>"
			        & [Current duration label]
			        & "</text><text x='290.5' y='140' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>duration</text><text x='20' y='177' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Client</text><text x='99' y='213' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='600' fill='" & _c_ink & "'>"
			        & [Current client]
			        & "</text><text x='99' y='237' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & _c_muted & "'>"
			        & [Current client phone]
			        & "</text><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#CFA660'/><stop offset='1' stop-color='#A97C33'/></linearGradient></defs><circle cx='308' cy='219' r='29' fill='url(#g)'/><g transform='translate(297 208) scale(0.916667)' fill='none' stroke='#FFFFFF' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384' /></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: fe940bf2-4d12-50c0-838c-568a50d8c755
		dataCategory: ImageUrl

	measure 'Current flight (SVG)' =
			
			VAR _c_future = [Color future]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _p = [Current progress]
			VAR _id = [Current flight ID]
			VAR _ref = [Reference time]
			VAR _checkin = CALCULATE ( MAX ( FactFlight[CheckIn] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id ) <= _ref
			VAR _boarding = CALCULATE ( MAX ( FactFlight[Boarding] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id ) <= _ref
			VAR _takeoff = CALCULATE ( MAX ( FactFlight[TakeOff] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id ) <= _ref
			VAR _landing = CALCULATE ( MAX ( FactFlight[Landing] ), REMOVEFILTERS ( FactFlight ), FactFlight[FlightID] = _id ) <= _ref
			VAR _x = 40 + 192 * _p
			VAR _anneau = 2 * PI () * 13
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='444.5' height='294.8' viewBox='0 0 454 304' preserveAspectRatio='none'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#CFA660'/><stop offset='1' stop-color='#A97C33'/></linearGradient><style>.h{transform-box:fill-box;transform-origin:center;animation:p 1.6s ease-out infinite}@keyframes p{0%{transform:scale(1);opacity:.6}100%{transform:scale(2.4);opacity:0}}</style></defs><text x='25' y='38' font-family='Segoe UI, Arial, sans-serif' font-size='21' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Current Flight</text><rect x='305' y='14' width='103' height='34' rx='17' fill='" & _c_tile & "' stroke='" & _c_line & "' stroke-width='1'/><rect x='22' y='58' width='228' height='171' rx='14' fill='url(#g)'/><text x='42' y='99' font-family='Segoe UI, Arial, sans-serif' font-size='23' font-weight='600' fill='#FFFFFF'>"
			        & [Current origin]
			        & "</text><text x='42' y='120' font-family='Segoe UI, Arial, sans-serif' font-size='14' fill='#FFFFFF' fill-opacity='0.85'>"
			        & [Current origin city]
			        & "</text><text x='230' y='99' font-family='Segoe UI, Arial, sans-serif' font-size='23' font-weight='600' fill='#FFFFFF' text-anchor='end'>"
			        & [Current destination]
			        & "</text><text x='230' y='120' font-family='Segoe UI, Arial, sans-serif' font-size='14' fill='#FFFFFF' fill-opacity='0.85' text-anchor='end'>"
			        & [Current destination city]
			        & "</text><g transform='translate(118 116) scale(1.41667) rotate(45 12 12)' fill='#FFFFFF' stroke='#FFFFFF' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z' /></g><line x1='40' y1='170' x2='232' y2='170' stroke='#FFFFFF' stroke-opacity='0.35' stroke-width='4' stroke-linecap='round'/><line x1='40' y1='170' x2='40' y2='170' stroke='#FFFFFF' stroke-width='4' stroke-linecap='round'><animate attributeName='x2' from='40' to='"
			        & FORMAT ( _x, "0.0", "en-US" )
			        & "' dur='1.6s' fill='freeze'/></line><circle cx='40' cy='170' r='7.5' fill='#FFFFFF'><animate attributeName='cx' from='40' to='"
			        & FORMAT ( _x, "0.0", "en-US" )
			        & "' dur='1.6s' fill='freeze'/></circle><text x='41' y='200' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='#FFFFFF'>"
			        & [Current take-off time]
			        & "</text><text x='231' y='200' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='#FFFFFF' text-anchor='end'>"
			        & [Current landing time]
			        & "</text><line x1='282' y1='80' x2='282' y2='212' stroke='" & _c_line & "' stroke-width='2'/><line x1='282' y1='80' x2='282' y2='123' stroke='"
			        & IF ( _boarding, "#C89C50", "" & _c_line & "" )
			        & "' stroke-width='2'/>"
			        & IF ( _checkin && NOT _boarding, "<circle class='h' cx='282' cy='80' r='9' fill='#C89C50'/>" )
			        & IF ( _checkin, "<circle cx='282' cy='80' r='9' fill='#C89C50'/><g transform='translate(276 74) scale(0.5)' fill='none' stroke='#FFFFFF' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5' /></g>", "<circle cx='282' cy='80' r='8' fill='" & _c_tile & "' stroke='" & _c_future & "' stroke-width='2'/>" )
			        & "<text x='305' y='85' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='"
			        & IF ( _checkin, "" & _c_ink & "", "" & _c_muted & "" )
			        & "'>Check-in</text><text x='431' y='85' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='"
			        & IF ( _checkin, "" & _c_ink & "", "" & _c_muted & "" )
			        & "' text-anchor='end'>"
			        & [Current check-in time]
			        & "</text><line x1='282' y1='123' x2='282' y2='167' stroke='"
			        & IF ( _takeoff, "#C89C50", "" & _c_line & "" )
			        & "' stroke-width='2'/>"
			        & IF ( _boarding && NOT _takeoff, "<circle class='h' cx='282' cy='123' r='9' fill='#C89C50'/>" )
			        & IF ( _boarding, "<circle cx='282' cy='123' r='9' fill='#C89C50'/><g transform='translate(276 117) scale(0.5)' fill='none' stroke='#FFFFFF' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5' /></g>", "<circle cx='282' cy='123' r='8' fill='" & _c_tile & "' stroke='" & _c_future & "' stroke-width='2'/>" )
			        & "<text x='305' y='128' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='"
			        & IF ( _boarding, "" & _c_ink & "", "" & _c_muted & "" )
			        & "'>Boarding</text><text x='431' y='128' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='"
			        & IF ( _boarding, "" & _c_ink & "", "" & _c_muted & "" )
			        & "' text-anchor='end'>"
			        & [Current boarding time]
			        & "</text><line x1='282' y1='167' x2='282' y2='212' stroke='"
			        & IF ( _landing, "#C89C50", "" & _c_line & "" )
			        & "' stroke-width='2'/>"
			        & IF ( _takeoff && NOT _landing, "<circle class='h' cx='282' cy='167' r='9' fill='#C89C50'/>" )
			        & IF ( _takeoff, "<circle cx='282' cy='167' r='9' fill='#C89C50'/><g transform='translate(276 161) scale(0.5)' fill='none' stroke='#FFFFFF' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5' /></g>", "<circle cx='282' cy='167' r='8' fill='" & _c_tile & "' stroke='" & _c_future & "' stroke-width='2'/>" )
			        & "<text x='305' y='172' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='"
			        & IF ( _takeoff, "" & _c_ink & "", "" & _c_muted & "" )
			        & "'>Take-off</text><text x='431' y='172' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='"
			        & IF ( _takeoff, "" & _c_ink & "", "" & _c_muted & "" )
			        & "' text-anchor='end'>"
			        & [Current take-off time]
			        & "</text>"
			        & IF ( _landing && NOT FALSE (), "<circle class='h' cx='282' cy='212' r='9' fill='#C89C50'/>" )
			        & IF ( _landing, "<circle cx='282' cy='212' r='9' fill='#C89C50'/><g transform='translate(276 206) scale(0.5)' fill='none' stroke='#FFFFFF' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5' /></g>", "<circle cx='282' cy='212' r='8' fill='" & _c_tile & "' stroke='" & _c_future & "' stroke-width='2'/>" )
			        & "<text x='305' y='217' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='"
			        & IF ( _landing, "" & _c_ink & "", "" & _c_muted & "" )
			        & "'>Landing</text><text x='431' y='217' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='"
			        & IF ( _landing, "" & _c_ink & "", "" & _c_muted & "" )
			        & "' text-anchor='end'>"
			        & [Current landing time]
			        & "</text><rect x='22' y='244' width='413' height='48' rx='12' fill='" & _c_tile & "'/><circle cx='50' cy='268' r='13' fill='none' stroke='#E5CFA5' stroke-width='4.5'/><circle cx='50' cy='268' r='13' fill='none' stroke='#C89C50' stroke-width='4.5' stroke-linecap='round' transform='rotate(-90 50 268)' stroke-dasharray='"
			        & FORMAT ( _anneau, "0.00", "en-US" )
			        & "' stroke-dashoffset='"
			        & FORMAT ( _anneau, "0.00", "en-US" )
			        & "'><animate attributeName='stroke-dashoffset' from='"
			        & FORMAT ( _anneau, "0.00", "en-US" )
			        & "' to='"
			        & FORMAT ( _anneau * ( 1 - _p ), "0.00", "en-US" )
			        & "' dur='1.6s' fill='freeze'/></circle><text x='80' y='274' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='" & _c_ink & "'>"
			        & [Current progress label]
			        & "</text><line x1='226' y1='256' x2='226' y2='280' stroke='" & _c_line & "' stroke-width='1.5'/><text x='250' y='273' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Flight details</text><g transform='translate(404 261) scale(0.625)' fill='none' stroke='" & _c_ink & "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='m6 9 6 6 6-6' /></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 856b7575-381f-52a0-98db-78cbb9c91490
		dataCategory: ImageUrl

	measure 'Cruise speed (SVG)' =
			
			VAR _c_avg = [Color avg]
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _c_togglebg = [Color togglebg]
			VAR _c_track = [Color track]
			VAR _c_track2 = [Color track2]
			VAR _load = [Selected gauge mode] = "Load"
			VAR _v = IF ( _load, [Current load], [Current cruise speed] )
			VAR _a = IF ( _load, [Avg load], [Avg cruise speed] )
			VAR _max = IF ( _load, 1, 600 )
			VAR _nv = ROUND ( _v / _max * 44, 0 )
			VAR _na = ROUND ( _a / _max * 40, 0 )
			VAR _ext = CONCATENATEX ( GENERATESERIES ( 0, 43 ), VAR _ang = -135 + [Value] * 270 / 43
			    RETURN "<rect x='171.5' y='76' width='9' height='26' rx='3' fill='" & _c_track & "' transform='rotate(" & FORMAT ( _ang, "0.0", "en-US" ) & " 176 202)'>"
			        & IF ( [Value] < _nv, "<animate attributeName='fill' to='" & IF ( [Value] < _nv * 0.5, "#D9BC82", "#C89C50" ) & "' begin='" & FORMAT ( [Value] * 0.035, "0.00", "en-US" ) & "s' dur='0.12s' fill='freeze'/>" )
			        & "</rect>", "", [Value], ASC )
			VAR _int = CONCATENATEX ( GENERATESERIES ( 0, 39 ), VAR _ang = -135 + [Value] * 270 / 39
			    RETURN "<rect x='172.5' y='106' width='7' height='18' rx='2.5' fill='" & _c_track2 & "' transform='rotate(" & FORMAT ( _ang, "0.0", "en-US" ) & " 176 202)'>"
			        & IF ( [Value] < _na, "<animate attributeName='fill' to='" & _c_avg & "' begin='" & FORMAT ( 0.2 + [Value] * 0.035, "0.00", "en-US" ) & "s' dur='0.12s' fill='freeze'/>" )
			        & "</rect>", "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='345.7' height='325' viewBox='0 0 353 333' preserveAspectRatio='none'><text x='22' y='34' font-family='Segoe UI, Arial, sans-serif' font-size='21' font-weight='600' fill='" & _c_ink & "'>"
			        & IF ( _load, "Load Factor", "Cruise Speed" )
			        & "</text><rect x='194' y='13' width='141' height='34' rx='17' fill='" & _c_togglebg & "'/><circle cx='28' cy='62' r='6' fill='" & _c_avg & "'/><text x='42' y='67' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & _c_muted & "'>"
			        & IF ( _load, "Average Load", "Average Speed" )
			        & "</text><circle cx='191' cy='62' r='6' fill='#C89C50'/><text x='205' y='67' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & _c_muted & "'>"
			        & IF ( _load, "Current Load", "Current Speed" )
			        & "</text>"
			        & _ext
			        & _int
			        & "<text x='176' y='206' font-family='Segoe UI, Arial, sans-serif' font-size='40' font-weight='600' fill='" & _c_ink & "' text-anchor='middle'>"
			        & IF ( _load, FORMAT ( _v, "0%" ), FORMAT ( _v, "0" ) )
			        & "</text><text x='176' y='233' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='" & _c_muted & "' text-anchor='middle'>"
			        & IF ( _load, "seats filled", "knots" )
			        & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: fb0f8607-adbf-5588-8a9d-8daf9682181e
		dataCategory: ImageUrl

	measure 'Fleet card (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _c_track = [Color track]
			VAR _u = [Fleet utilization]
			VAR _c = 2 * PI () * 16
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='444.5' height='294.8' viewBox='0 0 454 304' preserveAspectRatio='none'><text x='20' y='33' font-family='Segoe UI, Arial, sans-serif' font-size='22' font-weight='600' fill='" & _c_ink & "'>"
			        & [Shown model]
			        & "</text><text x='20' y='57' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='" & _c_muted & "'>"
			        & [Shown model category]
			        & "</text><text x='300' y='31' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Fleet utilization</text><text x='300' y='56' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='600' fill='" & _c_ink & "'>"
			        & [Fleet utilization label]
			        & "</text><circle cx='418' cy='40' r='16' fill='none' stroke='" & _c_track & "' stroke-width='5'/><circle cx='418' cy='40' r='16' fill='none' stroke='#C89C50' stroke-width='5' stroke-linecap='round' transform='rotate(-90 418 40)' stroke-dasharray='"
			        & FORMAT ( _c, "0.00", "en-US" )
			        & "' stroke-dashoffset='"
			        & FORMAT ( _c, "0.00", "en-US" )
			        & "'><animate attributeName='stroke-dashoffset' from='"
			        & FORMAT ( _c, "0.00", "en-US" )
			        & "' to='"
			        & FORMAT ( _c * ( 1 - _u ), "0.00", "en-US" )
			        & "' dur='1.4s' fill='freeze'/></circle><path d='M0,245 H454 V287 A17,17 0 0 1 437,304 H17 A17,17 0 0 1 0,287 Z' fill='" & _c_tile & "'/><g transform='translate(22 263) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' /><path d='M16 3.128a4 4 0 0 1 0 7.744' /><path d='M22 21v-2a4 4 0 0 0-3-3.87' /><circle cx='9' cy='7' r='4' /></g><text x='54' y='272' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "'>"
			        & [Shown model seats]
			        & "</text><text x='54' y='289' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>passengers</text><g transform='translate(144 263) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10' /><path d='M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20' /><path d='M2 12h20' /></g><text x='176' y='272' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "'>"
			        & [Shown model range label]
			        & "</text><text x='176' y='289' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>range</text><g transform='translate(255 263) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='m12 14 4-4' /><path d='M3.34 19a10 10 0 1 1 17.32 0' /></g><text x='287' y='272' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "'>"
			        & [Shown model speed label]
			        & "</text><text x='287' y='289' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>max speed</text><g transform='translate(373 263) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2v20' /><path d='m8 18 4 4 4-4' /><path d='m8 6 4-4 4 4' /></g><text x='405' y='272' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "'>"
			        & [Shown model height label]
			        & "</text><text x='405' y='289' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>height</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: aecc34ed-f5b5-5b1f-945b-53cfad5c9ea3
		dataCategory: ImageUrl

	measure 'Route map (SVG)' =
			
			VAR _c_card = [Color card]
			VAR _c_halo = [Color halo]
			VAR _c_ink = [Color ink]
			VAR _c_mapdim = [Color mapdim]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _c_togglebg = [Color togglebg]
			VAR _net = [Selected map mode] = "Network"
			VAR _o = [Current origin]
			VAR _d = [Current destination]
			VAR _p = [Current progress]
			VAR _olon = LOOKUPVALUE ( DimAirport[Longitude], DimAirport[AirportCode], _o )
			VAR _olat = LOOKUPVALUE ( DimAirport[Latitude], DimAirport[AirportCode], _o )
			VAR _dlon = LOOKUPVALUE ( DimAirport[Longitude], DimAirport[AirportCode], _d )
			VAR _dlat = LOOKUPVALUE ( DimAirport[Latitude], DimAirport[AirportCode], _d )
			VAR _x1 = ( ( _olon - ( -5.0 ) ) / 13.9000 * 355 )
			VAR _y1 = ( ( 52.0 - _olat ) / 14.6000 * 620 )
			VAR _x2 = ( ( _dlon - ( -5.0 ) ) / 13.9000 * 355 )
			VAR _y2 = ( ( 52.0 - _dlat ) / 14.6000 * 620 )
			VAR _cx = ( _x1 + _x2 ) / 2 + ( _y2 - _y1 ) * 0.22
			VAR _cy = ( _y1 + _y2 ) / 2 - ( _x2 - _x1 ) * 0.22
			VAR _route = "M" & FORMAT ( _x1, "0.0", "en-US" ) & "," & FORMAT ( _y1, "0.0", "en-US" ) & " Q" & FORMAT ( _cx, "0.0", "en-US" ) & "," & FORMAT ( _cy, "0.0", "en-US" ) & " " & FORMAT ( _x2, "0.0", "en-US" ) & "," & FORMAT ( _y2, "0.0", "en-US" )
			VAR _p1 = [Period start]
			VAR _p2 = [Period end]
			VAR _t = [Reference time]
			VAR _r0 = ADDCOLUMNS ( CALCULATETABLE ( SUMMARIZE ( FactFlight, FactFlight[Origin], FactFlight[Destination] ),
			        DATESBETWEEN ( DimDate[Date], _p1, _p2 ), FactFlight[TakeOff] <= _t ),
			    "@n", CALCULATE ( COUNTROWS ( FactFlight ), DATESBETWEEN ( DimDate[Date], _p1, _p2 ), FactFlight[TakeOff] <= _t ) )
			VAR _r1 = ADDCOLUMNS ( TOPN ( 50, _r0, [@n], DESC ),
			    "@x1", ( ( LOOKUPVALUE ( DimAirport[Longitude], DimAirport[AirportCode], FactFlight[Origin] ) - ( -5.0 ) ) / 13.9000 * 355 ),
			    "@y1", ( ( 52.0 - LOOKUPVALUE ( DimAirport[Latitude], DimAirport[AirportCode], FactFlight[Origin] ) ) / 14.6000 * 620 ),
			    "@x2", ( ( LOOKUPVALUE ( DimAirport[Longitude], DimAirport[AirportCode], FactFlight[Destination] ) - ( -5.0 ) ) / 13.9000 * 355 ),
			    "@y2", ( ( 52.0 - LOOKUPVALUE ( DimAirport[Latitude], DimAirport[AirportCode], FactFlight[Destination] ) ) / 14.6000 * 620 ) )
			VAR _nmax = MAXX ( _r1, [@n] )
			VAR _arcs = CONCATENATEX ( _r1, VAR _k = [@n] / _nmax
			    VAR _qx = ( [@x1] + [@x2] ) / 2 + ( [@y2] - [@y1] ) * 0.18 VAR _qy = ( [@y1] + [@y2] ) / 2 - ( [@x2] - [@x1] ) * 0.18
			    RETURN "<path d='M" & FORMAT ( [@x1], "0.0", "en-US" ) & "," & FORMAT ( [@y1], "0.0", "en-US" ) & " Q" & FORMAT ( _qx, "0.0", "en-US" ) & "," & FORMAT ( _qy, "0.0", "en-US" )
			        & " " & FORMAT ( [@x2], "0.0", "en-US" ) & "," & FORMAT ( [@y2], "0.0", "en-US" ) & "' fill='none' stroke='#C89C50' stroke-width='" & FORMAT ( 0.8 + 3 * _k, "0.0", "en-US" )
			        & "' stroke-opacity='" & FORMAT ( 0.3 + 0.6 * _k, "0.00", "en-US" ) & "' stroke-linecap='round' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'>"
			        & "<animate attributeName='stroke-dashoffset' from='1' to='0' begin='" & FORMAT ( 0.7 * ( 1 - _k ), "0.00", "en-US" ) & "s' dur='1s' fill='freeze'/></path>",
			    "", [@n], ASC )
			VAR _a = FILTER ( ADDCOLUMNS ( DimAirport,
			        "@t", VAR _c = DimAirport[AirportCode] RETURN SUMX ( FILTER ( _r0, FactFlight[Origin] = _c || FactFlight[Destination] = _c ), [@n] ),
			        "@x", ( ( DimAirport[Longitude] - ( -5.0 ) ) / 13.9000 * 355 ), "@y", ( ( 52.0 - DimAirport[Latitude] ) / 14.6000 * 620 ) ),
			    [@t] > 0 && DimAirport[Longitude] >= -5.0 && DimAirport[Longitude] <= 8.9 && DimAirport[Latitude] >= 37.4 && DimAirport[Latitude] <= 52.0 )
			VAR _amax = MAXX ( _a, [@t] )
			VAR _pts = CONCATENATEX ( _a, VAR _r = 3 + 4 * [@t] / _amax
			    RETURN "<circle cx='" & FORMAT ( [@x], "0.0", "en-US" ) & "' cy='" & FORMAT ( [@y], "0.0", "en-US" ) & "' r='0' fill='" & _c_tile & "' stroke='#C89C50' stroke-width='2'>"
			        & "<animate attributeName='r' from='0' to='" & FORMAT ( _r, "0.0", "en-US" ) & "' begin='0.4s' dur='0.4s' fill='freeze'/></circle>", "" )
			VAR _top = TOPN ( 6, _a, [@t], DESC )
			VAR _vus = FILTER ( _top, VAR _t0 = [@t] VAR _x0 = [@x] VAR _y0 = [@y] RETURN
			    ISEMPTY ( FILTER ( _top, [@t] > _t0 && ABS ( [@x] - _x0 ) < 46 && ABS ( [@y] - _y0 ) < 18 ) ) )
			VAR _libs = CONCATENATEX ( _vus, VAR _r = 3 + 4 * [@t] / _amax
			    VAR _haut = [@y] < 60
			    RETURN "<text x='" & IF ( _haut, FORMAT ( [@x], "0.0", "en-US" ), IF ( [@x] > 290, FORMAT ( [@x] - _r - 6, "0.0", "en-US" ), FORMAT ( [@x] + _r + 6, "0.0", "en-US" ) ) )
			        & "' y='" & IF ( _haut, FORMAT ( [@y] + _r + 16, "0.0", "en-US" ), FORMAT ( [@y] + 5, "0.0", "en-US" ) )
			        & "' text-anchor='" & IF ( _haut, "middle", IF ( [@x] > 290, "end", "start" ) ) & "' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='" & _c_ink & "' stroke='" & _c_halo & "' stroke-width='4' paint-order='stroke' stroke-linejoin='round'>"
			        & DimAirport[AirportCode] & "</text>", "" )
			VAR _nr = COUNTROWS ( _r0 )
			VAR _nf = SUMX ( _r0, [@n] )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='347.6' height='609.5' viewBox='0 0 355 620' preserveAspectRatio='none'><rect x='-3' y='-3' width='361' height='626' rx='19' fill='#0E0F12' fill-opacity='" & _c_mapdim & "'/><rect x='1' y='1' width='353' height='618' rx='17' fill='none' stroke='" & _c_card & "' stroke-width='4'/>"
			        & IF ( _net,
			        _arcs
			        & _pts
			        & _libs
			        & "<rect x='15' y='557' width='236' height='50' rx='12' fill='" & _c_tile & "'/><text x='31' y='589' font-family='Segoe UI, Arial, sans-serif' font-size='18'><tspan font-weight='600' fill='" & _c_ink & "'>"
			        & _nr
			        & "</tspan><tspan fill='" & _c_muted & "'> routes · </tspan><tspan font-weight='600' fill='" & _c_ink & "'>"
			        & FORMAT ( _nf, "#,0" )
			        & "</tspan><tspan fill='" & _c_muted & "'> flights</tspan></text>",
			        "<path id='r' d='"
			        & _route
			        & "' fill='none' stroke='#C89C50' stroke-width='3' stroke-dasharray='9 7' stroke-linecap='round'/><circle cx='"
			        & FORMAT ( _x1, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _y1, "0.0", "en-US" )
			        & "' r='9' fill='" & _c_tile & "' stroke='#C89C50' stroke-width='2.5'/><circle cx='"
			        & FORMAT ( _x1, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _y1, "0.0", "en-US" )
			        & "' r='4' fill='" & _c_ink & "'/><text x='"
			        & IF ( _x1 > 290, FORMAT ( _x1 - 16, "0.0", "en-US" ), FORMAT ( _x1 + 16, "0.0", "en-US" ) )
			        & "' y='"
			        & FORMAT ( _y1 + 6, "0.0", "en-US" )
			        & "' text-anchor='"
			        & IF ( _x1 > 290, "end", "start" )
			        & "' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='600' fill='" & _c_ink & "' stroke='" & _c_halo & "' stroke-width='4' paint-order='stroke' stroke-linejoin='round'>"
			        & _o
			        & "</text><circle cx='"
			        & FORMAT ( _x2, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _y2, "0.0", "en-US" )
			        & "' r='9' fill='" & _c_tile & "' stroke='#C89C50' stroke-width='2.5'/><circle cx='"
			        & FORMAT ( _x2, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _y2, "0.0", "en-US" )
			        & "' r='4' fill='" & _c_ink & "'/><text x='"
			        & IF ( _x2 > 290, FORMAT ( _x2 - 16, "0.0", "en-US" ), FORMAT ( _x2 + 16, "0.0", "en-US" ) )
			        & "' y='"
			        & FORMAT ( _y2 + 6, "0.0", "en-US" )
			        & "' text-anchor='"
			        & IF ( _x2 > 290, "end", "start" )
			        & "' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='600' fill='" & _c_ink & "' stroke='" & _c_halo & "' stroke-width='4' paint-order='stroke' stroke-linejoin='round'>"
			        & _d
			        & "</text><g><g transform='scale(1.25)'><g transform='translate(-12 -12) scale(1) rotate(45 12 12)' fill='#C89C50' stroke='#C89C50' stroke-width='1.2' stroke-linecap='round' stroke-linejoin='round'><path d='M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z' /></g></g><animateMotion dur='2.4s' fill='freeze' rotate='auto' calcMode='linear' keyTimes='0;1' keyPoints='0;"
			        & FORMAT ( _p, "0.000", "en-US" )
			        & "'><mpath href='#r'/></animateMotion></g><rect x='15' y='557' width='162' height='50' rx='12' fill='" & _c_tile & "'/><text x='31' y='590' font-family='Segoe UI, Arial, sans-serif' font-size='21'><tspan font-weight='600' fill='" & _c_ink & "'>"
			        & FORMAT ( [Current flown km], "#,0" )
			        & "</tspan><tspan fill='" & _c_muted & "'> / "
			        & FORMAT ( [Current distance], "#,0" )
			        & " km</tspan></text>" )
			        & "<text x='21' y='37' font-family='Segoe UI, Arial, sans-serif' font-size='21' font-weight='600' fill='" & _c_ink & "' stroke='" & _c_halo & "' stroke-width='4' paint-order='stroke' stroke-linejoin='round'>Route Map</text><rect x='190' y='14' width='151' height='34' rx='17' fill='" & _c_togglebg & "'/><rect x='304' y='429' width='36' height='36' rx='9' fill='" & _c_tile & "'/><g transform='translate(313 438) scale(0.75)' fill='none' stroke='" & _c_ink & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14' /><path d='M12 5v14' /></g><rect x='304' y='469' width='36' height='36' rx='9' fill='" & _c_tile & "'/><line x1='315' y1='487' x2='329' y2='487' stroke='" & _c_ink & "' stroke-width='2' stroke-linecap='round'/><rect x='304' y='524' width='36' height='36' rx='9' fill='" & _c_tile & "'/><g transform='translate(313 533) scale(0.75)' fill='none' stroke='" & _c_ink & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 7V5a2 2 0 0 1 2-2h2' /><path d='M17 3h2a2 2 0 0 1 2 2v2' /><path d='M21 17v2a2 2 0 0 1-2 2h-2' /><path d='M7 21H5a2 2 0 0 1-2-2v-2' /></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 7965ddd8-773d-55b9-b89f-dba3620455c7
		dataCategory: ImageUrl

	measure 'Profile (SVG)' =
			
