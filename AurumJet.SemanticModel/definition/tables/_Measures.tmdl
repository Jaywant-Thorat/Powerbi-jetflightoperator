			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='140' height='52' viewBox='0 0 140 52'><text x='0' y='20' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='" & _c_ink & "'>"
			        & [User name]
