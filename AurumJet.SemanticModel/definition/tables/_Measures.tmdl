	measure 'Flights performance (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _c_track2 = [Color track2]
			VAR _on = [On time share]
			VAR _dl = [Delayed share]
			VAR _cn = [Cancelled share]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='312.7' height='159.4' viewBox='0 0 355 181' preserveAspectRatio='none'><text x='22' y='38' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Flight Performance</text><text x='333' y='36' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>"
			        & UPPER ( LEFT ( [Period phrase], 1 ) ) & MID ( [Period phrase], 2, 50 )
			        & "</text><circle cx='92' cy='112' r='54' fill='none' stroke='" & _c_track2 & "' stroke-width='12'/><circle cx='92' cy='112' r='54' fill='none' stroke='#C89C50' stroke-width='12' stroke-dasharray='0 339.29' transform='rotate("
			        & FORMAT ( -90 + 360 * ( 0 ), "0.0", "en-US" )
			        & " 92 112)'><animate attributeName='stroke-dasharray' from='0 339.29' to='"
			        & FORMAT ( 339.2920 * ( _on ), "0.0", "en-US" ) & " 339.29"
			        & "' begin='0s' dur='0.6s' fill='freeze'/></circle><circle cx='92' cy='112' r='54' fill='none' stroke='#E5CFA5' stroke-width='12' stroke-dasharray='0 339.29' transform='rotate("
			        & FORMAT ( -90 + 360 * ( 0 + _on ), "0.0", "en-US" )
			        & " 92 112)'><animate attributeName='stroke-dasharray' from='0 339.29' to='"
			        & FORMAT ( 339.2920 * ( _dl ), "0.0", "en-US" ) & " 339.29"
			        & "' begin='0.25s' dur='0.6s' fill='freeze'/></circle><circle cx='92' cy='112' r='54' fill='none' stroke='#D9534F' stroke-width='12' stroke-dasharray='0 339.29' transform='rotate("
			        & FORMAT ( -90 + 360 * ( 0 + _on + _dl ), "0.0", "en-US" )
			        & " 92 112)'><animate attributeName='stroke-dasharray' from='0 339.29' to='"
			        & FORMAT ( 339.2920 * ( _cn ), "0.0", "en-US" ) & " 339.29"
			        & "' begin='0.5s' dur='0.6s' fill='freeze'/></circle><g transform='translate(81 72) scale(0.916667) rotate(45 12 12)' fill='#C89C50' stroke='#C89C50' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z' /></g><text x='92' y='124' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='24' font-weight='700' fill='" & _c_ink & "'>"
			        & FORMAT ( _on, "0%" )
			        & "</text><text x='92' y='142' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>On time</text><circle cx='190' cy='73' r='6' fill='#2F9E5B'/><text x='204' y='78' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>On time</text><text x='333' y='78' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='" & _c_ink & "'>"
			        & FORMAT ( _on, "0%" )
			        & "</text><circle cx='190' cy='107' r='6' fill='#E0B252'/><text x='204' y='112' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Delayed</text><text x='333' y='112' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='" & _c_ink & "'>"
			        & FORMAT ( _dl, "0%" )
			        & "</text><circle cx='190' cy='141' r='6' fill='#D9534F'/><text x='204' y='146' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Cancelled</text><text x='333' y='146' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='" & _c_ink & "'>"
			        & FORMAT ( _cn, "0%" )
			        & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: 963881de-90cf-5db8-aa97-1209b588edc5
		dataCategory: ImageUrl

	measure 'Flights top destinations (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_track2 = [Color track2]
			VAR _p1 = [Period start]
			VAR _p2 = [Period end]
			VAR _t = [Reference time]
			VAR _dest = ADDCOLUMNS ( CALCULATETABLE ( SUMMARIZE ( FactFlight, FactFlight[Destination] ), DATESBETWEEN ( DimDate[Date], _p1, _p2 ), FactFlight[TakeOff] <= _t ),
			    "@n", CALCULATE ( COUNTROWS ( FactFlight ), DATESBETWEEN ( DimDate[Date], _p1, _p2 ), FactFlight[TakeOff] <= _t ),
			    "@k", CALCULATE ( COUNTROWS ( FactFlight ), DATESBETWEEN ( DimDate[Date], _p1, _p2 ), FactFlight[TakeOff] <= _t ) * 1000000 + UNICODE ( MID ( FactFlight[Destination], 1, 1 ) ) * 10000 + UNICODE ( MID ( FactFlight[Destination], 2, 1 ) ) * 100 + UNICODE ( MID ( FactFlight[Destination], 3, 1 ) ) )
			VAR _top = TOPN ( 5, _dest, [@k], DESC )
			VAR _max = MAXX ( _top, [@n] )
			VAR _rang = ADDCOLUMNS ( _top, "@i", VAR _k = [@k] RETURN COUNTROWS ( FILTER ( _top, [@k] >= _k ) ), "@ville", LOOKUPVALUE ( DimAirport[City], DimAirport[AirportCode], FactFlight[Destination] ) )
			VAR _lignes = CONCATENATEX ( _rang, VAR _y = 62 + ( [@i] - 1 ) * 21.5 VAR _w = DIVIDE ( [@n], _max ) * 150
			    RETURN "<text x='22' y='" & FORMAT ( _y, "0.0", "en-US" ) & "' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>" & [@ville] & " (" & FactFlight[Destination] & ")</text>"
			        & "<rect x='150' y='" & FORMAT ( _y - 9, "0.0", "en-US" ) & "' width='150' height='9' rx='4.5' fill='" & _c_track2 & "'/>"
			        & "<rect x='150' y='" & FORMAT ( _y - 9, "0.0", "en-US" ) & "' width='0' height='9' rx='4.5' fill='url(#tg)'><animate attributeName='width' from='0' to='" & FORMAT ( _w, "0.0", "en-US" )
			        & "' begin='" & FORMAT ( [@i] * 0.08, "0.00", "en-US" ) & "s' dur='0.7s' fill='freeze'/></rect>"
			        & "<text x='333' y='" & FORMAT ( _y, "0.0", "en-US" ) & "' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>" & [@n] & "</text>",
			    "", [@i], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='312.7' height='142.5' viewBox='0 0 355 162' preserveAspectRatio='none'><defs><linearGradient id='tg' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#D9B26F'/><stop offset='1' stop-color='#C89C50'/></linearGradient></defs><text x='22' y='36' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Top Destinations</text><text x='333' y='34' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='#C89C50' text-anchor='end'>See all</text>"
			        & _lignes
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: 1dcecb38-d8fd-5118-8367-2c8c1e596b4e
		dataCategory: ImageUrl

	measure 'Flights activity (SVG)' =
			
			VAR _c_avg = [Color avg]
			VAR _c_card = [Color card]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _p1 = [Period start]
			VAR _p2 = [Period end]
			VAR _t = [Reference time]
			VAR _vols = CALCULATETABLE ( FactFlight, DATESBETWEEN ( DimDate[Date], _p1, _p2 ), FactFlight[TakeOff] <= _t )
			VAR _dep = ADDCOLUMNS ( GENERATESERIES ( 0, 23 ), "@v", VAR _h = [Value] RETURN COUNTROWS ( FILTER ( _vols, HOUR ( FactFlight[TakeOff] ) = _h ) ) + 0 )
			VAR _arr = ADDCOLUMNS ( GENERATESERIES ( 0, 23 ), "@v", VAR _h = [Value] RETURN COUNTROWS ( FILTER ( _vols, HOUR ( FactFlight[Landing] ) = _h ) ) + 0 )
			VAR _vmax = MAX ( MAXX ( _dep, [@v] ), MAXX ( _arr, [@v] ) )
			VAR _pas = SWITCH ( TRUE (), _vmax <= 4, 1, _vmax <= 8, 2, _vmax <= 20, 5, _vmax <= 40, 10, _vmax <= 100, 25, _vmax <= 200, 50, 100 )
			VAR _ymax = MAX ( CEILING ( _vmax / _pas, 1 ), 1 ) * _pas
			VAR _xyd = ADDCOLUMNS ( _dep, "@x", 52 + [Value] * 19.1304, "@y", 168 - DIVIDE ( [@v], _ymax ) * 110, "@o", [Value] + 1 )
			VAR _xya = ADDCOLUMNS ( _arr, "@x", 52 + [Value] * 19.1304, "@y", 168 - DIVIDE ( [@v], _ymax ) * 110, "@o", [Value] + 1 )
			VAR _nbd = COUNTROWS ( _xyd )
			VAR _ptd = ADDCOLUMNS ( _xyd, "@xn", VAR _k = [@o] RETURN MAXX ( FILTER ( _xyd, [@o] = _k + 1 ), [@x] ),
			    "@yn", VAR _k = [@o] RETURN MAXX ( FILTER ( _xyd, [@o] = _k + 1 ), [@y] ) )
			VAR _x0d = MINX ( FILTER ( _ptd, [@o] = 1 ), [@x] ) VAR _y0d = MINX ( FILTER ( _ptd, [@o] = 1 ), [@y] )
			VAR _xnd = MINX ( FILTER ( _ptd, [@o] = _nbd ), [@x] ) VAR _ynd = MINX ( FILTER ( _ptd, [@o] = _nbd ), [@y] )
			VAR _chd = "M" & FORMAT ( _x0d, "0.0", "en-US" ) & "," & FORMAT ( _y0d, "0.0", "en-US" ) & CONCATENATEX ( FILTER ( _ptd, [@o] < _nbd ),
			    IF ( [@o] = 1, "", " Q" & FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y], "0.0", "en-US" ) & " " ) & IF ( [@o] = 1, " L", "" )
			    & FORMAT ( ( [@x] + [@xn] ) / 2, "0.0", "en-US" ) & "," & FORMAT ( ( [@y] + [@yn] ) / 2, "0.0", "en-US" ), "", [@o], ASC )
			    & " L" & FORMAT ( _xnd, "0.0", "en-US" ) & "," & FORMAT ( _ynd, "0.0", "en-US" )
			VAR _nba = COUNTROWS ( _xya )
			VAR _pta = ADDCOLUMNS ( _xya, "@xn", VAR _k = [@o] RETURN MAXX ( FILTER ( _xya, [@o] = _k + 1 ), [@x] ),
			    "@yn", VAR _k = [@o] RETURN MAXX ( FILTER ( _xya, [@o] = _k + 1 ), [@y] ) )
			VAR _x0a = MINX ( FILTER ( _pta, [@o] = 1 ), [@x] ) VAR _y0a = MINX ( FILTER ( _pta, [@o] = 1 ), [@y] )
			VAR _xna = MINX ( FILTER ( _pta, [@o] = _nba ), [@x] ) VAR _yna = MINX ( FILTER ( _pta, [@o] = _nba ), [@y] )
			VAR _cha = "M" & FORMAT ( _x0a, "0.0", "en-US" ) & "," & FORMAT ( _y0a, "0.0", "en-US" ) & CONCATENATEX ( FILTER ( _pta, [@o] < _nba ),
			    IF ( [@o] = 1, "", " Q" & FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y], "0.0", "en-US" ) & " " ) & IF ( [@o] = 1, " L", "" )
			    & FORMAT ( ( [@x] + [@xn] ) / 2, "0.0", "en-US" ) & "," & FORMAT ( ( [@y] + [@yn] ) / 2, "0.0", "en-US" ), "", [@o], ASC )
			    & " L" & FORMAT ( _xna, "0.0", "en-US" ) & "," & FORMAT ( _yna, "0.0", "en-US" )
			VAR _pic = TOPN ( 1, _xyd, [@v], DESC, [Value], ASC )
			VAR _px = MAXX ( _pic, [@x] ) VAR _py = MAXX ( _pic, [@y] ) VAR _pv = MAXX ( _pic, [@v] )
			VAR _haut = _py < 96
			VAR _bx = IF ( _haut, IF ( _px > 400, _px - 88, _px + 14 ), _px - 36 ) VAR _by = IF ( _haut, _py - 12, _py - 36 )
			VAR _axes = CONCATENATEX ( GENERATESERIES ( 0, _ymax / _pas ), VAR _yy = 168 - [Value] * _pas / _ymax * 110
			    RETURN "<line x1='52' x2='492' y1='" & FORMAT ( _yy, "0.0", "en-US" ) & "' y2='" & FORMAT ( _yy, "0.0", "en-US" ) & "' stroke='" & _c_line & "' stroke-width='1' stroke-dasharray='" & IF ( [Value] = 0, "0", "2 4" ) & "'/>"
			        & "<text x='40' y='" & FORMAT ( _yy + 4, "0.0", "en-US" ) & "' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='" & _c_muted & "'>" & FORMAT ( _pas * [Value], "0" ) & "</text>", "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='451.7' height='175.7' viewBox='0 0 513 200' preserveAspectRatio='none'><defs><linearGradient id='ad' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#C89C50' stop-opacity='0.40'/><stop offset='1' stop-color='#C89C50' stop-opacity='0.05'/></linearGradient><linearGradient id='aa' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" & _c_avg & "' stop-opacity='0.22'/><stop offset='1' stop-color='" & _c_avg & "' stop-opacity='0.03'/></linearGradient></defs><text x='22' y='36' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Flight Activity</text><circle cx='327' cy='31' r='5.5' fill='#C89C50'/><text x='339' y='36' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Departures</text><circle cx='431' cy='31' r='5.5' fill='" & _c_avg & "'/><text x='443' y='36' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Arrivals</text>"
			        & _axes
			        & "<text x='52' y='188' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>00h</text><text x='128.522' y='188' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>04h</text><text x='205.043' y='188' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>08h</text><text x='281.565' y='188' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>12h</text><text x='358.087' y='188' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>16h</text><text x='434.609' y='188' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>20h</text><path d='"
			        & _cha & " L" & FORMAT ( _xna, "0.0", "en-US" ) & ",168 L" & FORMAT ( _x0a, "0.0", "en-US" ) & ",168 Z"
			        & "' fill='url(#aa)' opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.3s' dur='0.8s' fill='freeze'/></path><path d='"
			        & _cha
			        & "' fill='none' stroke='" & _c_avg & "' stroke-width='2' stroke-linecap='round' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'><animate attributeName='stroke-dashoffset' from='1' to='0' dur='1.3s' fill='freeze'/></path><path d='"
			        & _chd & " L" & FORMAT ( _xnd, "0.0", "en-US" ) & ",168 L" & FORMAT ( _x0d, "0.0", "en-US" ) & ",168 Z"
			        & "' fill='url(#ad)' opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.3s' dur='0.8s' fill='freeze'/></path><path d='"
			        & _chd
			        & "' fill='none' stroke='#C89C50' stroke-width='2' stroke-linecap='round' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'><animate attributeName='stroke-dashoffset' from='1' to='0' dur='1.3s' fill='freeze'/></path><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.2s' dur='0.4s' fill='freeze'/><line x1='"
			        & FORMAT ( _px, "0.0", "en-US" )
			        & "' x2='"
			        & FORMAT ( _px, "0.0", "en-US" )
			        & "' y1='"
			        & FORMAT ( _py, "0.0", "en-US" )
			        & "' y2='168' stroke='#C89C50' stroke-width='1.2' stroke-dasharray='3 3'/><circle cx='"
			        & FORMAT ( _px, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _py, "0.0", "en-US" )
			        & "' r='6' fill='#C89C50' stroke='" & _c_card & "' stroke-width='2.5'/><rect x='"
			        & FORMAT ( _bx, "0.0", "en-US" )
			        & "' y='"
			        & FORMAT ( _by, "0.0", "en-US" )
			        & "' width='72' height='24' rx='6' fill='#C89C50'/><text x='"
			        & FORMAT ( _bx + 36, "0.0", "en-US" )
			        & "' y='"
			        & FORMAT ( _by + 16.5, "0.0", "en-US" )
			        & "' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='600' fill='#FFFFFF'>"
			        & _pv & IF ( _pv = 1, " flight", " flights" )
			        & "</text></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: 41b0e177-7a98-54fc-8fbb-a27e6018993c
		dataCategory: ImageUrl

	measure 'Flights delay causes (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _c_track2 = [Color track2]
			VAR _p1 = [Period start]
			VAR _p2 = [Period end]
			VAR _t = [Reference time]
			VAR _vols = CALCULATETABLE ( FactFlight, DATESBETWEEN ( DimDate[Date], _p1, _p2 ), FactFlight[TakeOff] <= _t, FactFlight[DelayMin] > 15 )
			VAR _tot = COUNTROWS ( _vols ) + 0
			VAR _c0 = DIVIDE ( COUNTROWS ( FILTER ( _vols, FactFlight[DelayCause] = "Weather" ) ), _tot ) + 0
			VAR _c1 = DIVIDE ( COUNTROWS ( FILTER ( _vols, FactFlight[DelayCause] = "ATC" ) ), _tot ) + 0
			VAR _c2 = DIVIDE ( COUNTROWS ( FILTER ( _vols, FactFlight[DelayCause] = "Technical" ) ), _tot ) + 0
			VAR _c3 = DIVIDE ( COUNTROWS ( FILTER ( _vols, FactFlight[DelayCause] = "Operations" ) ), _tot ) + 0
			VAR _c4 = DIVIDE ( COUNTROWS ( FILTER ( _vols, FactFlight[DelayCause] = "Other" ) ), _tot ) + 0
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='375.3' height='175.7' viewBox='0 0 426 200' preserveAspectRatio='none'><text x='22' y='36' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Delay Causes</text><text x='404' y='34' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='#C89C50' text-anchor='end'>See all</text><circle cx='108' cy='118' r='56' fill='none' stroke='" & _c_track2 & "' stroke-width='22'/><circle cx='108' cy='118' r='56' fill='none' stroke='#C89C50' stroke-width='22' stroke-dasharray='0 351.86' transform='rotate("
			        & FORMAT ( -90 + 360 * ( 0 ), "0.0", "en-US" )
			        & " 108 118)'><animate attributeName='stroke-dasharray' from='0 351.86' to='"
			        & FORMAT ( 351.8584 * ( _c0 ), "0.0", "en-US" ) & " 351.86"
			        & "' begin='0s' dur='0.6s' fill='freeze'/></circle><circle cx='108' cy='118' r='56' fill='none' stroke='#E9D7B5' stroke-width='22' stroke-dasharray='0 351.86' transform='rotate("
			        & FORMAT ( -90 + 360 * ( 0 + _c0 ), "0.0", "en-US" )
			        & " 108 118)'><animate attributeName='stroke-dasharray' from='0 351.86' to='"
			        & FORMAT ( 351.8584 * ( _c1 ), "0.0", "en-US" ) & " 351.86"
			        & "' begin='0.25s' dur='0.6s' fill='freeze'/></circle><circle cx='108' cy='118' r='56' fill='none' stroke='#D8C29A' stroke-width='22' stroke-dasharray='0 351.86' transform='rotate("
			        & FORMAT ( -90 + 360 * ( 0 + _c0 + _c1 ), "0.0", "en-US" )
			        & " 108 118)'><animate attributeName='stroke-dasharray' from='0 351.86' to='"
			        & FORMAT ( 351.8584 * ( _c2 ), "0.0", "en-US" ) & " 351.86"
			        & "' begin='0.5s' dur='0.6s' fill='freeze'/></circle><circle cx='108' cy='118' r='56' fill='none' stroke='#4A4A4F' stroke-width='22' stroke-dasharray='0 351.86' transform='rotate("
			        & FORMAT ( -90 + 360 * ( 0 + _c0 + _c1 + _c2 ), "0.0", "en-US" )
			        & " 108 118)'><animate attributeName='stroke-dasharray' from='0 351.86' to='"
			        & FORMAT ( 351.8584 * ( _c3 ), "0.0", "en-US" ) & " 351.86"
			        & "' begin='0.75s' dur='0.6s' fill='freeze'/></circle><circle cx='108' cy='118' r='56' fill='none' stroke='#9A9AA0' stroke-width='22' stroke-dasharray='0 351.86' transform='rotate("
			        & FORMAT ( -90 + 360 * ( 0 + _c0 + _c1 + _c2 + _c3 ), "0.0", "en-US" )
			        & " 108 118)'><animate attributeName='stroke-dasharray' from='0 351.86' to='"
			        & FORMAT ( 351.8584 * ( _c4 ), "0.0", "en-US" ) & " 351.86"
			        & "' begin='1s' dur='0.6s' fill='freeze'/></circle><text x='108' y='122' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='24' font-weight='700' fill='" & _c_ink & "'>"
			        & _tot
			        & "</text><text x='108' y='141' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='12' fill='" & _c_muted & "'>"
			        & IF ( _tot = 1, "Delay", "Delays" )
			        & "</text><circle cx='222' cy='61' r='7' fill='#C89C50'/><text x='240' y='66' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Weather</text><text x='404' y='66' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>"
			        & FORMAT ( _c0, "0%" )
			        & "</text><circle cx='222' cy='88' r='7' fill='#E9D7B5'/><text x='240' y='93' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>ATC</text><text x='404' y='93' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>"
			        & FORMAT ( _c1, "0%" )
			        & "</text><circle cx='222' cy='115' r='7' fill='#D8C29A'/><text x='240' y='120' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Technical</text><text x='404' y='120' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>"
			        & FORMAT ( _c2, "0%" )
			        & "</text><circle cx='222' cy='142' r='7' fill='#4A4A4F'/><text x='240' y='147' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Operations</text><text x='404' y='147' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>"
			        & FORMAT ( _c3, "0%" )
			        & "</text><circle cx='222' cy='169' r='7' fill='#9A9AA0'/><text x='240' y='174' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Other</text><text x='404' y='174' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink & "'>"
			        & FORMAT ( _c4, "0%" )
			        & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: 94d99356-8b9e-5694-b98a-ef29c4abf40e
		dataCategory: ImageUrl

	measure 'Flights reach (SVG)' =
			
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='312.7' height='175.7' viewBox='0 0 355 200' preserveAspectRatio='none'><defs><linearGradient id='rg' x1='0' y1='0' x2='0' y2='1'><stop offset='0.35' stop-color='#000000' stop-opacity='0'/><stop offset='1' stop-color='#000000' stop-opacity='0.62'/></linearGradient></defs><rect width='355' height='200' rx='19.3' fill='url(#rg)'/><text x='22' y='160' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='#FFFFFF' text-anchor='start'>Global Reach</text><text x='22' y='183' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='#FFFFFF' text-anchor='start' fill-opacity='0.88'>Fly further with Aurum Jet</text><circle cx='315' cy='166' r='19' fill='none' stroke='#FFFFFF' stroke-width='1.6'/><g transform='translate(306 157) scale(0.75)' fill='none' stroke='#FFFFFF' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14' /><path d='m12 5 7 7-7 7' /></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 91 SVG Flights
		lineageTag: 5953f70a-db0e-565e-b9af-a0f8cf3764b2
		dataCategory: ImageUrl

	measure 'Booking backdrop dashboard (SVG)' =
			
			IF ( [Selected theme] = "Dark",
			    "data:image/jpeg;base64,",
