	measure 'Nav dashboard (SVG)' =
			
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='197' height='50' viewBox='0 0 197 50'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#CFA660'/><stop offset='1' stop-color='#A97C33'/></linearGradient></defs><rect x='0' y='0' width='197' height='50' rx='25' fill='url(#g)'/><g transform='translate(18 13) scale(1)' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8' /><path d='M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z' /></g><text x='61' y='31' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='#FFFFFF' text-anchor='start'>Dashboard</text><g transform='translate(164 15) scale(0.833333)' fill='none' stroke='#FFFFFF' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6' /></g></svg>"
