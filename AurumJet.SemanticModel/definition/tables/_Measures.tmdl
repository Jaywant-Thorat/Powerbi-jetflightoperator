	measure 'Booking backdrop flights (SVG)' =
			
			IF ( [Selected theme] = "Dark",
			    "data:image/jpeg;base64,",
			    "data:image/jpeg;base64," )
		displayFolder: 92 SVG Booking
		lineageTag: 8aebff2a-20df-561f-88b2-2dc2b8d6f422
