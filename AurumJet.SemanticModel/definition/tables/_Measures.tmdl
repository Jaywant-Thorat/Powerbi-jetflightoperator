		displayFolder: 00 Base
		lineageTag: e3584513-9210-528c-928a-4705269c8de5

	measure 'Client avatar' =
			
			VAR _id = [Current client ID]
			VAR _p = LOOKUPVALUE ( DimClient[FirstName], DimClient[ClientID], _id )
			VAR _g = IF ( _p IN { "Camille", "Emma", "Chloé", "Léa", "Inès", "Sofia", "Charlotte", "Amelia", "Giulia", "Hannah", "Elena", "Sarah", "Margaux", "Alice", "Juliette", "Olivia", "Francesca", "Clara", "Yasmine", "Diane" }, "F", "M" )
			VAR _n = COUNTROWS ( FILTER ( 'Avatar image', 'Avatar image'[Gender] = _g ) )
			VAR _k = MOD ( _id - 1, _n ) + 1
			VAR _b = MAXX ( FILTER ( 'Avatar image', 'Avatar image'[Gender] = _g && 'Avatar image'[Rank] = _k ), 'Avatar image'[Chunk] )
			RETURN IF ( NOT ISBLANK ( _b ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='60' height='60' viewBox='0 0 60 60'>"
			    & "<defs><clipPath id='c'><circle cx='30' cy='30' r='30'/></clipPath></defs>"
			    & "<image width='60' height='60' clip-path='url(%23c)' href='data:image/jpeg;base64," & _b & "'/></svg>" )
		displayFolder: 20 Current flight
		lineageTag: 0ddac6e2-ff2f-59fe-bf19-997f0ec6ba02
		dataCategory: ImageUrl

	measure 'Jet image' =
			
			VAR _m = [Shown model ID]
			VAR _t = [Selected theme]
			VAR _b = CONCATENATEX ( FILTER ( 'Jet image', 'Jet image'[ModelID] = _m && 'Jet image'[Theme] = _t ), 'Jet image'[Chunk], "", 'Jet image'[Part], ASC )
			RETURN IF ( NOT ISBLANK ( _m ), "data:image/jpeg;base64," & _b )
		displayFolder: 30 Fleet
		lineageTag: 82dc9023-dabb-532c-9322-6e781b5e501a
		dataCategory: ImageUrl

