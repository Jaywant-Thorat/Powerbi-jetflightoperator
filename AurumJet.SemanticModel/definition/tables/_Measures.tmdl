			    "<svg xmlns='http://www.w3.org/2000/svg' width='1440' height='872' viewBox='0 0 1440 872'><rect width='1440' height='872' fill='" & _c_page & "'/><rect width='216.7' height='872' fill='" & _c_sidebar & "'/><rect x='215.7' width='1' height='872' fill='" & _c_hairline & "'/><rect x='238.5' y='101.9' width='347.6' height='118.7' rx='17' fill='" & _c_card & "'/><rect x='606.1' y='101.9' width='444.5' height='118.7' rx='17' fill='" & _c_card & "'/><rect x='1070.6' y='101.9' width='347.6' height='118.7' rx='17' fill='" & _c_card & "'/><rect x='238.5' y='240.6' width='347.6' height='264.5' rx='17' fill='" & _c_card & "'/><rect x='238.5' y='525.1' width='345.7' height='325' rx='17' fill='" & _c_card & "'/><rect x='606.1' y='240.6' width='444.5' height='294.8' rx='17' fill='" & _c_card & "'/><rect x='606.1' y='555.4' width='444.5' height='294.8' rx='17' fill='" & _c_cardalt & "'/><rect x='1070.6' y='240.6' width='347.6' height='609.5' rx='17' fill='" & _c_card & "'/><rect x='15.8' y='792.7' width='190' height='51.5' rx='25.75' fill='" & _c_togglebg & "'/><rect x='600' y='31' width='296' height='40' rx='20' fill='" & _c_togglebg & "'/></svg>"
