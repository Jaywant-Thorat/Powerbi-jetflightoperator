	measure 'Booking dialog (SVG)' =
			
			VAR _c_badge = [Color badge]
			VAR _c_card = [Color card]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='560' height='420' viewBox='0 0 560 420'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#CFA660'/><stop offset='1' stop-color='#A97C33'/></linearGradient></defs><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='0.35s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 14' to='0 0' dur='0.35s' fill='freeze'/><rect x='0.5' y='0.5' width='559' height='419' rx='22' fill='" & _c_card & "' stroke='" & _c_line & "' stroke-width='1'/><circle cx='52' cy='56' r='24' fill='url(#g)'/><g transform='translate(40 44) scale(1)' fill='none' stroke='#FFFFFF' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14' /><path d='M12 5v14' /></g><text x='90' y='52' font-family='Segoe UI, Arial, sans-serif' font-size='24' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>New booking</text><text x='91' y='74' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='#C89C50' text-anchor='start'>Power Apps integration</text><circle cx='516' cy='44' r='18' fill='" & _c_tile & "'/><g transform='translate(508 36) scale(0.666667)' fill='none' stroke='" & _c_ink & "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 6 6 18' /><path d='m6 6 12 12' /></g><text x='32' y='116' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Power BI reports are read-only. With the Power Apps visual, this button</text><text x='32' y='137' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>can open a booking form right inside the report: create a flight, pick</text><text x='32' y='158' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>the client, the route and the aircraft, and see it in the dashboard.</text><rect x='32' y='188' width='496' height='1' fill='" & _c_line & "'/><rect x='440' y='202' width='88' height='22' rx='11' fill='" & _c_badge & "'/><text x='484' y='217' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='600' fill='" & _c_muted & "' text-anchor='middle'>Preview</text><text x='32' y='220' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Client</text><rect x='32' y='228' width='236' height='40' rx='10' fill='" & _c_tile & "' stroke='" & _c_line & "' stroke-width='1'/><text x='46' y='253' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Thomas Martin</text><text x='292' y='220' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Route</text><rect x='292' y='228' width='236' height='40' rx='10' fill='" & _c_tile & "' stroke='" & _c_line & "' stroke-width='1'/><text x='306' y='253' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>PAR → NCE</text><text x='32' y='284' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Date</text><rect x='32' y='292' width='236' height='40' rx='10' fill='" & _c_tile & "' stroke='" & _c_line & "' stroke-width='1'/><text x='46' y='317' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>16 Oct 2026 · 14:30</text><text x='292' y='284' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Aircraft</text><rect x='292' y='292' width='236' height='40' rx='10' fill='" & _c_tile & "' stroke='" & _c_line & "' stroke-width='1'/><text x='306' y='317' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Aurum X7</text><text x='32' y='381' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Demo report: no data is written.</text><rect x='306.75' y='356.75' width='110.5' height='38.5' rx='20' fill='none' stroke='" & _c_line & "' stroke-width='1.5'/><text x='362' y='381' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='" & _c_ink & "' text-anchor='middle'>Learn more</text><rect x='428' y='356' width='100' height='40' rx='20' fill='url(#g)'/><text x='478' y='381' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='#FFFFFF' text-anchor='middle'>Close</text></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 92 SVG Booking
		lineageTag: 51130cbe-64ad-512c-9fba-a5c99689858a
		dataCategory: ImageUrl

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4bde77e4-06d9-5c95-bb42-7f12fcf3261c
		summarizeBy: none
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
