model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DossierDonnees", "FactFlight", "FactCancellation", "DimDate", "DimAirport", "DimModel", "DimAircraft", "DimClient"]

annotation PBI_ProTooling = ["DevMode"]

ref table FactFlight
ref table DimDate
ref table DimAirport
ref table DimModel
ref table DimAircraft
ref table DimClient
ref table Theme
ref table Period
ref table 'Map mode'
ref table 'Gauge mode'
ref table 'Fleet picker'
ref table 'Flight picker'
ref table _Measures
ref table FactCancellation
ref table 'Flight status'
ref table 'Jet image'
ref table 'Avatar image'

ref cultureInfo en-US

